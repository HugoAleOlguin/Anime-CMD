            --ansi \
            --delimiter=$'\t' \
            --with-nth=1 \
            --prompt="👉 [ SELECCIONA SERVIDOR ] > " \
            --header="Anime disponible en múltiples plataformas. Elige tu servidor preferido:" \
            --height=~12 \
            --border=rounded \
            --info=inline \
            --margin=1 \
            --layout=reverse \
            --color=fg:#d0d0d0,bg:-1,hl:#00ff00,fg+:#00ff00,bg+:-1,hl+:#ffff00,pointer:#00ff00,info:#ffff00,prompt:#00ff00,header:#00ff00,marker:#00ff00,spinner:#00ff00)

        if [ -z "$chosen_server" ] || [[ "$chosen_server" == *"none"$'\t'*"back"* ]] || [[ "$chosen_server" == *"Volver"* ]]; then
            main
            return
        fi

        nuevaurl=$(echo "$chosen_server" | cut -f2)
        provider=$(echo "$chosen_server" | cut -f3)
    fi

    echo -e "${YELLOW}[~] Obteniendo lista de episodios de: ${WHITE}${clean_title}${NC}..."

    meta=$(get_anime_metadata "$nuevaurl" "$provider")
    num_episodios=$(echo "$meta" | cut -d'|' -f1)
    tipo=$(echo "$meta" | cut -d'|' -f2)

    if [ -z "$num_episodios" ] || [ "$num_episodios" -lt 1 ]; then
        num_episodios=1
    fi

    clear
    echo -e "${GREEN}[+] ANIME:${NC} ${WHITE}${clean_title}${NC} (${num_episodios} episodios - ${tipo})"
    capi=$(seq 1 "$num_episodios" | fzf \
        --prompt="👉 [ SELECCIONA UN EPISODIO ] > " \
        --height=~30 \
        --border=rounded \
        --reverse \
        --layout=reverse \
        --color=fg:#d0d0d0,bg:-1,hl:#00ff00,fg+:#00ff00,bg+:-1,hl+:#ffff00,pointer:#00ff00,info:#ffff00,prompt:#00ff00,header:#00ff00,marker:#00ff00,spinner:#00ff00)

    # Manejo de tecla ESC al elegir episodio
    if [ -z "$capi" ]; then
        arg1=""
        main
        return
    fi

    clear

    if [ "$tipo" == "Pelicula" ] || [ "$tipo" == "pelicula" ]; then
        capi="1"
    fi

    play_episode() {
        local ep_num=$1

        clear
        echo -e "${YELLOW}[~] Conectando con servidor de vídeo para el capítulo $ep_num...${NC}"

        raw_extract=$(extract_stream "$nuevaurl" "$provider" "$ep_num" "$AUDIO_PREF")
        src_contenido=$(echo "$raw_extract" | cut -d'|' -f1)
        detected_lang=$(echo "$raw_extract" | cut -d'|' -f2)
        stream_referer=$(echo "$raw_extract" | cut -d'|' -f3)

        if [ -z "$stream_referer" ]; then
            if [[ "$src_contenido" == *"yourupload"* ]] || [[ "$src_contenido" == *"vidcache"* ]]; then
                stream_referer="https://www.yourupload.com/"
            elif [ "$provider" == "animeonline" ]; then
                stream_referer="https://saidochesto.top/"
            elif [ "$provider" == "jkanime" ]; then
                stream_referer="https://jkanime.net/"
            elif [ "$provider" == "tioanime" ]; then
                stream_referer="https://tioanime.com/"
            elif [ "$provider" == "monoschinos" ]; then
                stream_referer="https://monoschinos.st/"
            elif [ "$provider" == "tiohentai" ]; then
                stream_referer="https://tiohentai.com/"
            fi
        fi

        if [ -z "$src_contenido" ]; then
            echo -e "${RED}[-] No se pudo extraer la transmisión para el capítulo $ep_num en $provider.${NC}"
            local failover_ok=0
            if [[ "$servers_data" == *"@@@"* ]]; then
                local alt_entries
                alt_entries=$(echo "$servers_data" | sed "s/@@@/\n/g")
                while IFS= read -r s_entry; do
                    [ -z "$s_entry" ] && continue
                    local alt_id alt_name alt_href
                    alt_id=$(echo "$s_entry" | cut -d"|" -f1)
                    alt_name=$(echo "$s_entry" | cut -d"|" -f2)
                    alt_href=$(echo "$s_entry" | cut -d"|" -f3-)
                    if [ "$alt_id" != "$provider" ]; then
                        echo -e "${YELLOW}[~] Probando failover automático con servidor alternativo: ${BOLD}${alt_name}${NC}..."
                        local alt_extract alt_src
                        alt_extract=$(extract_stream "$alt_href" "$alt_id" "$ep_num" "$AUDIO_PREF")
                        alt_src=$(echo "$alt_extract" | cut -d'|' -f1)
                        if [ -n "$alt_src" ]; then
                            echo -e "${GREEN}[✔] ¡Transmisión obtenida con éxito desde ${alt_name}!${NC}"
                            provider="$alt_id"
                            nuevaurl="$alt_href"
                            src_contenido="$alt_src"
                            detected_lang=$(echo "$alt_extract" | cut -d'|' -f2)
                            stream_referer=$(echo "$alt_extract" | cut -d'|' -f3)
                            failover_ok=1
                            sleep 1
                            break
                        fi
                    fi
                done <<< "$alt_entries"
            fi
            if [ $failover_ok -eq 0 ]; then
                read -r -p "Presiona ENTER para volver al menú..." dummy
                arg1=""
                main
                return
            fi
        fi

        clear
        local label_lang="Audio Latino"
        local title_prefix="[AUDIO LATINO]"
        if [ "$detected_lang" == "sub" ]; then
            label_lang="Subtitulado (Japonés)"
            title_prefix="[SUBTITULADO]"
        elif [ "$detected_lang" == "castellano" ]; then
            label_lang="Castellano"
            title_prefix="[CASTELLANO]"
        fi

        echo -e "${GREEN}════════════════════════════════════════════════════════════════${NC}"
        if [ "$detected_lang" == "latino" ]; then
            echo -e "  🔊 ${GREEN}${BOLD}REPRODUCIENDO EN AUDIO LATINO${NC}"
        else
            echo -e "  🇯🇵 ${YELLOW}${BOLD}REPRODUCIENDO EN JAPONÉS SUBTITULADO${NC}"
        fi
        echo -e "     ${GREEN}Anime:${NC}     ${WHITE}${clean_title}${NC}"
        echo -e "     ${GREEN}Capítulo:${NC}  ${WHITE}${ep_num}${NC}"
        echo -e "     ${GREEN}Fuente:${NC}    ${WHITE}${provider}${NC} (${label_lang})"
        if [ "$detected_lang" == "sub" ] && [ "$AUDIO_PREF" == "latino" ]; then
            echo -e "     ${YELLOW}Nota:${NC}      No se encontró doblaje latino para este episodio en esta fuente."
        fi
        echo -e "${GREEN}════════════════════════════════════════════════════════════════${NC}"
        echo -e "${GREEN}[~] Transmisión iniciada en MPV... (Presiona 'q' para menú de opciones)${NC}"

        ENV=$(detect_env)
        pos=0

        local ref_opt=""
        if [ -n "$stream_referer" ]; then
            ref_opt="--referrer=${stream_referer}"
        fi
        local ua_opt='--user-agent=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'

        local mpv_log
        mpv_log=$(mktemp 2>/dev/null || echo "$HOME/.anime/mpv_run.log")
        local mpv_exit=0

        case "$ENV" in
            wsl|windows|linux)
                local mpv_bin
                mpv_bin=$(find_mpv_cmd)
                if [ -n "$mpv_bin" ]; then
                    local t_start
                    t_start=$(date +%s 2>/dev/null || echo 0)

                    "$mpv_bin" $ref_opt "$ua_opt" --cache=yes --demuxer-max-bytes=150M --demuxer-readahead-secs=300 --start=$progress --msg-level=ffmpeg=no --force-media-title="${title_prefix} ${clean_title} - Capítulo ${ep_num}" "$src_contenido" > "$mpv_log" 2>&1
                    mpv_exit=$?

                    pos=$(grep -oE 'AV: [0-9]{2}:[0-9]{2}:[0-9]{2}' "$mpv_log" | tail -n 1 | sed 's/AV: //g')
                    local t_end
                    t_end=$(date +%s 2>/dev/null || echo 0)
                    local t_elapsed=$((t_end - t_start))

                    if [ $mpv_exit -ne 0 ] || ( [ -z "$pos" ] && [ $t_elapsed -lt 15 ] ); then
                        echo -e "${YELLOW}[!] La transmisión falló o el enlace fue rechazado por el servidor.${NC}"
                        if [[ "$servers_data" == *"@@@"* ]]; then
                            echo -e "${YELLOW}[~] Probando failover automático con servidor alternativo...${NC}"
                            local alt_entries
                            alt_entries=$(echo "$servers_data" | sed "s/@@@/\n/g")
                            while IFS= read -r s_entry; do
                                [ -z "$s_entry" ] && continue
                                local alt_id alt_name alt_href
                                alt_id=$(echo "$s_entry" | cut -d"|" -f1)
                                alt_name=$(echo "$s_entry" | cut -d"|" -f2)
                                alt_href=$(echo "$s_entry" | cut -d"|" -f3-)
                                if [ "$alt_id" != "$provider" ]; then
                                    echo -e "${YELLOW}[~] Probando failover con: ${BOLD}${alt_name}${NC}..."
                                    local alt_extract alt_src
                                    alt_extract=$(extract_stream "$alt_href" "$alt_id" "$ep_num" "$AUDIO_PREF")
                                    alt_src=$(echo "$alt_extract" | cut -d'|' -f1)
                                    if [ -n "$alt_src" ]; then
                                        echo -e "${GREEN}[✔] ¡Transmisión obtenida con éxito desde ${alt_name}!${NC}"
                                        provider="$alt_id"
                                        nuevaurl="$alt_href"
                                        src_contenido="$alt_src"
                                        detected_lang=$(echo "$alt_extract" | cut -d'|' -f2)
                                        stream_referer=$(echo "$alt_extract" | cut -d'|' -f3)
                                        rm -f "$mpv_log" 2>/dev/null
                                        play_episode "$ep_num"
                                        return
                                    fi
                                fi
                            done <<< "$alt_entries"
                        fi

                        echo ""
                        echo -e "${RED}════════════════════════════════════════════════════════════════${NC}"
                        echo -e "  ⚠️  ${RED}${BOLD}ERROR DE TRANSMISIÓN${NC}"
                        echo -e "  El reproductor se cerró porque el enlace fue rechazado o expiró."
                        echo -e "${RED}════════════════════════════════════════════════════════════════${NC}"
                        rm -f "$mpv_log" 2>/dev/null

                        local audio_toggle_err="🇯🇵 Cambiar a Subtitulado"
                        if [ "$AUDIO_PREF" != "latino" ]; then
                            audio_toggle_err="🔊 Cambiar a Audio Latino"
                        fi

                        local err_menu="🔄 Reintentar este capítulo\n$audio_toggle_err"
                        if [[ "$servers_data" == *"@@@"* ]]; then
                            err_menu+="\n🌐 Cambiar de servidor"
                        fi
                        err_menu+="\n🔍 Buscar otro anime\n❌ Salir"

                        local err_op
                        err_op=$(echo -e "$err_menu" | fzf \
                            --prompt="👉 [ ¿QUÉ DESEAS HACER? ] > " \
                            --height=15 \
                            --border=rounded \
                            --info=inline \
                            --margin=1 \
                            --layout=reverse \
                            --color=fg:#d0d0d0,bg:-1,hl:#00ff00,fg+:#00ff00,bg+:-1,hl+:#ffff00,pointer:#00ff00,info:#ffff00,prompt:#00ff00,header:#00ff00,marker:#00ff00,spinner:#00ff00)

                        if [[ "$err_op" == *"Reintentar"* ]]; then
                            play_episode "$ep_num"
                            return
                        elif [[ "$err_op" == *"Cambiar a"* ]]; then
                            if [[ "$AUDIO_PREF" == "latino" ]]; then
                                AUDIO_PREF="sub"
                            else
                                AUDIO_PREF="latino"
                            fi
                            play_episode "$ep_num"
                            return
                        elif [[ "$err_op" == *"Cambiar de servidor"* ]]; then
                            local server_menu_lines=""
                            local entries
                            entries=$(echo "$servers_data" | sed "s/@@@/\n/g")
                            while IFS= read -r s_entry; do
                                [ -z "$s_entry" ] && continue
                                local s_id s_name s_href
                                s_id=$(echo "$s_entry" | cut -d"|" -f1)
                                s_name=$(echo "$s_entry" | cut -d"|" -f2)
                                s_href=$(echo "$s_entry" | cut -d"|" -f3-)

                                local s_color="${MAGENTA}"
                                if [ "$s_id" == "animeonline" ]; then s_color="\033[38;5;208m"; fi
                                if [ "$s_id" == "tioanime" ]; then s_color="${MAGENTA}"; fi
                                if [ "$s_id" == "jkanime" ]; then s_color="${GREEN}"; fi
                                if [ "$s_id" == "monoschinos" ]; then s_color="${YELLOW}"; fi
                                if [ "$s_id" == "animeflv" ]; then s_color="${RED}"; fi
                                if [ "$s_id" == "tiohentai" ]; then s_color="\033[38;5;198m"; fi

                                local cur_mark=""
                                if [ "$s_id" == "$provider" ]; then cur_mark=" ${RED}(Falló)${NC}"; fi

                                server_menu_lines+="${s_color}● ${s_name}${NC}${cur_mark}"$'\t'"${s_href}"$'\t'"${s_id}"$'\n'
                            done <<< "$entries"
                            server_menu_lines+="❌ Cancelar"$'\t'"none"$'\t'"cancel"

                            chosen_server=$(echo -ne "$server_menu_lines" | fzf \
                                --ansi \
                                --delimiter=$'\t' \
                                --with-nth=1 \
                                --prompt="👉 [ CAMBIAR SERVIDOR ] > " \
                                --height=~10 \
                                --border=rounded \
                                --info=inline \
                                --margin=1 \
                                --layout=reverse \
                                --color=fg:#d0d0d0,bg:-1,hl:#00ff00,fg+:#00ff00,bg+:-1,hl+:#ffff00,pointer:#00ff00,info:#ffff00,prompt:#00ff00,header:#00ff00,marker:#00ff00,spinner:#00ff00)

                            if [ -n "$chosen_server" ] && [[ "$chosen_server" != *"cancel"* ]] && [[ "$chosen_server" != *"Cancelar"* ]]; then
                                nuevaurl=$(echo "$chosen_server" | cut -f2)
                                provider=$(echo "$chosen_server" | cut -f3)
                            fi
                            play_episode "$ep_num"
                            return
                        elif [[ "$err_op" == *"Buscar"* ]] || [[ -z "$err_op" ]]; then
                            arg1=""
                            main
                            return
                        elif [[ "$err_op" == *"Salir"* ]]; then
                            clear
                            exit 0
                        fi
                        return
                    fi
                else
                    echo -e "${RED}mpv no encontrado en el sistema${NC}"
                fi
                rm -f "$mpv_log" 2>/dev/null
                ;;
            termux)
                if pm list packages | grep -q 'org.videolan.vlc'; then
                    am start -a android.intent.action.VIEW -d "$src_contenido" -n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity
                    pos=0
                else
                    termux-open-url "$src_contenido"
                    pos=0
                fi
                ;;
        esac

        # Actualizar historial SQLite
        "$PY_CMD" - "$clean_title" "$nuevaurl" "$provider" "$ep_num" "$pos" "$servers_data" <<'END_HIST'
import sys, sqlite3, os
try:
    anime = sys.argv[1]
    url = sys.argv[2]
    provider = sys.argv[3]
    capi = sys.argv[4]
    progress = sys.argv[5] if len(sys.argv) > 5 and sys.argv[5] else "00:00:00"
    servers_data = sys.argv[6] if len(sys.argv) > 6 else ""

    home_dir = os.path.expanduser("~")
    db_dir = os.path.join(home_dir, ".anime")
    os.makedirs(db_dir, exist_ok=True)
    db_path = os.path.join(db_dir, "history.db")

    conect = sqlite3.connect(db_path)
    cursor = conect.cursor()
    cursor.execute("CREATE TABLE IF NOT EXISTS animes (id INTEGER PRIMARY KEY, anime TEXT, url TEXT, provider TEXT, last_cap TEXT, progress TEXT, servers_data TEXT)")

    cursor.execute("PRAGMA table_info(animes)")
    cols = [col[1] for col in cursor.fetchall()]
    if "url" not in cols:
        cursor.execute("ALTER TABLE animes ADD COLUMN url TEXT")
    if "provider" not in cols:
        cursor.execute("ALTER TABLE animes ADD COLUMN provider TEXT")
    if "progress" not in cols:
        cursor.execute("ALTER TABLE animes ADD COLUMN progress TEXT DEFAULT '00:00:00'")
    if "servers_data" not in cols:
        cursor.execute("ALTER TABLE animes ADD COLUMN servers_data TEXT DEFAULT ''")
    conect.commit()

    cursor.execute('SELECT id FROM animes WHERE anime = ?', (anime,))
    row = cursor.fetchone()

    if row is None:
        cursor.execute('INSERT INTO animes (anime, url, provider, last_cap, progress, servers_data) VALUES (?, ?, ?, ?, ?, ?)', (anime, url, provider, capi, progress, servers_data))
    else:
        cursor.execute("UPDATE animes SET url = ?, provider = ?, last_cap = ?, progress = ?, servers_data = ? WHERE anime = ?", (url, provider, capi, progress, servers_data, anime))

    conect.commit()
    conect.close()
except Exception:
    pass
END_HIST

        local audio_toggle_label="🇯🇵 Cambiar a Subtitulado"
        if [ "$AUDIO_PREF" != "latino" ]; then
            audio_toggle_label="🔊 Cambiar a Audio Latino"
        fi

        local menu_options="▶ Siguiente capítulo\n◀ Capítulo anterior\n$audio_toggle_label"
        if [[ "$servers_data" == *"@@@"* ]]; then
            menu_options+="\n🌐 Cambiar de servidor"
        fi
        menu_options+="\n🔍 Buscar otro anime\n❌ Salir"

        op=$(echo -e "$menu_options" | fzf \
            --prompt="👉 [ ¿QUÉ DESEAS HACER? ] > " \
            --height=15 \
            --border=rounded \
            --info=inline \
            --margin=1 \
            --layout=reverse \
            --color=fg:#d0d0d0,bg:-1,hl:#00ff00,fg+:#00ff00,bg+:-1,hl+:#ffff00,pointer:#00ff00,info:#ffff00,prompt:#00ff00,header:#00ff00,marker:#00ff00,spinner:#00ff00)

        if [[ "$op" == *"Siguiente"* ]]; then
            progress="00:00:00"
            play_episode $((ep_num + 1))
        elif [[ "$op" == *"anterior"* ]]; then
            progress="00:00:00"
            if [ $ep_num -gt 1 ]; then
                play_episode $((ep_num - 1))
            else
                play_episode 1
            fi
        elif [[ "$op" == *"Cambiar a"* ]]; then
            if [[ "$AUDIO_PREF" == "latino" ]]; then
                AUDIO_PREF="sub"
            else
                AUDIO_PREF="latino"
            fi
            play_episode $ep_num
        elif [[ "$op" == *"Cambiar de servidor"* ]]; then
            local server_menu_lines=""
            local entries
            entries=$(echo "$servers_data" | sed "s/@@@/\n/g")
            while IFS= read -r s_entry; do
                [ -z "$s_entry" ] && continue
                local s_id s_name s_href
                s_id=$(echo "$s_entry" | cut -d"|" -f1)
                s_name=$(echo "$s_entry" | cut -d"|" -f2)
                s_href=$(echo "$s_entry" | cut -d"|" -f3-)

                local s_color="${MAGENTA}"
                if [ "$s_id" == "animeonline" ]; then s_color="\033[38;5;208m"; fi
                if [ "$s_id" == "tioanime" ]; then s_color="${MAGENTA}"; fi
                if [ "$s_id" == "jkanime" ]; then s_color="${GREEN}"; fi
                if [ "$s_id" == "monoschinos" ]; then s_color="${YELLOW}"; fi
                if [ "$s_id" == "animeflv" ]; then s_color="${RED}"; fi
                if [ "$s_id" == "tiohentai" ]; then s_color="\033[38;5;198m"; fi

                local cur_mark=""
                if [ "$s_id" == "$provider" ]; then cur_mark=" ${GREEN}(Actual)${NC}"; fi

                server_menu_lines+="${s_color}● ${s_name}${NC}${cur_mark}"$'\t'"${s_href}"$'\t'"${s_id}"$'\n'
            done <<< "$entries"
            server_menu_lines+="❌ Cancelar"$'\t'"none"$'\t'"cancel"

            chosen_server=$(echo -ne "$server_menu_lines" | fzf \
                --ansi \
                --delimiter=$'\t' \
                --with-nth=1 \
                --prompt="👉 [ CAMBIAR SERVIDOR ] > " \
                --height=~10 \
                --border=rounded \
                --info=inline \
                --margin=1 \
                --layout=reverse \
                --color=fg:#d0d0d0,bg:-1,hl:#00ff00,fg+:#00ff00,bg+:-1,hl+:#ffff00,pointer:#00ff00,info:#ffff00,prompt:#00ff00,header:#00ff00,marker:#00ff00,spinner:#00ff00)

            if [ -n "$chosen_server" ] && [[ "$chosen_server" != *"cancel"* ]] && [[ "$chosen_server" != *"Cancelar"* ]]; then
                nuevaurl=$(echo "$chosen_server" | cut -f2)
                provider=$(echo "$chosen_server" | cut -f3)
            fi
            play_episode $ep_num
        elif [[ "$op" == *"Buscar otro"* ]] || [[ -z "$op" ]]; then
            arg1=""
            main
        elif [[ "$op" == *"Salir"* ]]; then
            clear
            exit 0
        fi
    }

    play_episode "$capi"
}

if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    main "$@"
fi
