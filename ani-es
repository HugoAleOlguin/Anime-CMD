GRAY='\033[0;90m'
BOLD='\033[1m'
NC='\033[0m'
# Alias para compatibilidad pero redefinidos sin tonalidades azules
BLUE='\033[0;35m'
CYAN='\033[1;37m'

show_help() {
    echo ""
    echo -e "    ${GREEN}${BOLD}Uso:${NC} anime [opciones] [busqueda]"
    echo ""
    echo -e "    ${YELLOW}${BOLD}Opciones:${NC}"
    echo "      -s, --sub        Forzar versión en japonés subtitulada [SUB]"
    echo "      -c, --continue   Continuar el anime en el último capítulo y minuto visto"
    echo "      -u, --update     Actualizar Anime-CMD a la última versión"
    echo "      -h, --help       Mostrar esta ayuda"
    echo "      -v, --version    Mostrar versión instalada"
    echo ""
    echo -e "    ${YELLOW}${BOLD}Características del motor v2.2:${NC}"
    echo -e "      • ${GREEN}Motor Multi-Proveedor:${NC} Búsqueda en paralelo (Anime Online Ninja, TioAnime, MonosChinos, JKAnime)."
    echo -e "      • ${GREEN}Agrupación Inteligente:${NC} Títulos unificados con insignias de todos los servidores disponibles."
