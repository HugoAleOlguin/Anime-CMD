export PYTHONIOENCODING="utf-8"
export LC_ALL="C.UTF-8"

# Colores de texto ANSI (sin azules ni derivados para máxima legibilidad)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
MAGENTA='\033[0;35m'
