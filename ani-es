    if [ -z "$provider" ]; then provider="jkanime"; fi

    if [[ "$titulo_elegido" == *"🔊"* ]] || [[ "$titulo_elegido" == *"[LAT]"* ]]; then
        AUDIO_PREF="latino"
    fi

    # Limpiar título para visualización
    clean_title=$(echo "$titulo_elegido" | sed -E 's/^(🔊|🇯🇵|🇪🇸)?\s*\[(LAT|SUB|CAST)\]\s*\[[a-zA-Z0-9_-]+\]\s*//g')

    echo -e "${CYAN}[~] Obteniendo lista de episodios de: ${WHITE}${clean_title}${NC}..."

    meta=$(get_anime_metadata "$nuevaurl" "$provider")
    num_episodios=$(echo "$meta" | cut -d'|' -f1)
    tipo=$(echo "$meta" | cut -d'|' -f2)

    if [ -z "$num_episodios" ] || [ "$num_episodios" -lt 1 ]; then
        num_episodios=1
    fi

    clear
    echo -e "${GREEN}[+] ANIME:${NC} ${WHITE}${clean_title}${NC} (${num_episodios} episodios - ${tipo})"
    capi=$(seq 1 "$num_episodios" | fzf \
        --prompt="👉 [ SELECCIONA UN EPISODIO ] > " \
        --height=~30 \
        --border=rounded \
        --reverse \
        --layout=reverse \
        --color=fg:#d0d0d0,bg:-1,hl:#00ff00,fg+:#ffffff,bg+:-1,hl+:#00ff00,pointer:#00ff00,info:#00ff00,prompt:#00ff00)

    # Manejo de tecla ESC al elegir episodio
    if [ -z "$capi" ]; then
        arg1=""
        main
        return
    fi

    clear

    if [ "$tipo" == "Pelicula" ] || [ "$tipo" == "pelicula" ]; then
        capi="1"
    fi

    play_episode() {
        local ep_num=$1

        clear
        echo -e "${CYAN}[~] Conectando con servidor de vídeo para el capítulo $ep_num...${NC}"

        raw_extract=$(extract_stream "$nuevaurl" "$provider" "$ep_num" "$AUDIO_PREF")
        src_contenido=$(echo "$raw_extract" | cut -d'|' -f1)
        detected_lang=$(echo "$raw_extract" | cut -d'|' -f2)

        if [ -z "$src_contenido" ]; then
            echo -e "${RED}[-] No se pudo extraer la transmisión para el capítulo $ep_num en $provider.${NC}"
            read -p "Presiona ENTER para volver al menú..." dummy
            arg1=""
            main
            return
        fi

        clear
        local label_lang="Audio Latino"
        local title_prefix="[AUDIO LATINO]"
        if [ "$detected_lang" == "sub" ]; then
            label_lang="Subtitulado (Japonés)"
            title_prefix="[SUBTITULADO]"
        elif [ "$detected_lang" == "castellano" ]; then
            label_lang="Castellano"
            title_prefix="[CASTELLANO]"
        fi

        echo -e "${GREEN}════════════════════════════════════════════════════════════════${NC}"
        if [ "$detected_lang" == "latino" ]; then
            echo -e "  🔊 ${GREEN}${BOLD}REPRODUCIENDO EN AUDIO LATINO${NC}"
        else
