        echo -e "     ${CYAN}Capítulo:${NC}  ${WHITE}${ep_num}${NC}"
        echo -e "     ${CYAN}Fuente:${NC}    ${WHITE}${provider}${NC} (${label_lang})"
        if [ "$detected_lang" == "sub" ] && [ "$AUDIO_PREF" == "latino" ]; then
            echo -e "     ${YELLOW}Nota:${NC}      No se encontró doblaje latino para este episodio en esta fuente."
        fi
        echo -e "${GREEN}════════════════════════════════════════════════════════════════${NC}"
        echo -e "${CYAN}[~] Transmisión iniciada en MPV... (Presiona 'q' para menú de opciones)${NC}"

        ENV=$(detect_env)
        pos=0

        case "$ENV" in
            wsl|windows)
                if command -v mpv >/dev/null 2>&1; then
                    pos=$(mpv --cache=yes --demuxer-max-bytes=150M --demuxer-readahead-secs=300 --start=$progress --msg-level=ffmpeg=no --force-media-title="${title_prefix} ${clean_title} - Capítulo ${ep_num}" "$src_contenido" | grep -oE 'AV: [0-9]{2}:[0-9]{2}:[0-9]{2}' | tail -n 1 | sed 's/AV: //g' 2>&1)
                elif command -v mpv.exe >/dev/null 2>&1; then
