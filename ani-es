    echo -e "      • ${GREEN}Detección Inteligente:${NC} Detecta servidores dual-audio y enlaces alternativos de doblaje."
    echo ""
}

show_version() {
    echo -e "Anime-CMD ${PURPLE}v${VERSION}${NC} - Motor Agregador Multi-Plataforma"
}

update_anime() {
    echo ""
    echo -e "${GREEN}==========================================================${NC}"
    echo -e "${GREEN}         🔄 Actualizando Anime-CMD a la última versión     ${NC}"
    echo -e "${GREEN}==========================================================${NC}"
    echo ""

    local REPO_BASE="https://raw.githubusercontent.com/HugoAleOlguin/Anime-CMD"
    local LATEST_SHA=""
    if command -v curl >/dev/null 2>&1; then
        LATEST_SHA=$(curl -sSL -H "User-Agent: Anime-CMD" "https://api.github.com/repos/HugoAleOlguin/Anime-CMD/commits/main" 2>/dev/null | grep -m 1 '"sha":' | cut -d '"' -f 4 || true)
    fi

    local SCRIPT_URL
    if [ -n "$LATEST_SHA" ]; then
        SCRIPT_URL="${REPO_BASE}/${LATEST_SHA}/ani-es"
    else
        local CACHE_BUST
        CACHE_BUST=$(date +%s 2>/dev/null || echo "1")
        SCRIPT_URL="${REPO_BASE}/main/ani-es?v=${CACHE_BUST}"
    fi
    
    local TARGET_FILE="$0"
    if command -v cygpath >/dev/null 2>&1; then
        TARGET_FILE="$(cygpath -u "$0" 2>/dev/null || echo "$0")"
    fi
    if [ ! -f "$TARGET_FILE" ]; then
        if [ -f "$HOME/.anime/ani-es" ]; then
            TARGET_FILE="$HOME/.anime/ani-es"
        elif command -v anime >/dev/null 2>&1; then
            TARGET_FILE="$(command -v anime)"
        elif command -v ani-es >/dev/null 2>&1; then
            TARGET_FILE="$(command -v ani-es)"
        fi
    fi

    echo -e "${GREEN}[*] Descargando última versión de Anime-CMD...${NC}"
    local TMP_FILE="${TARGET_FILE}.tmp"
    
    local DOWNLOAD_OK=0
    if command -v curl >/dev/null 2>&1; then
        if curl -sSL -H "Cache-Control: no-cache, no-store, must-revalidate" -H "Pragma: no-cache" "${SCRIPT_URL}" -o "$TMP_FILE"; then
            DOWNLOAD_OK=1
        fi
    elif command -v wget >/dev/null 2>&1; then
        if wget --no-cache -qO "$TMP_FILE" "${SCRIPT_URL}"; then
            DOWNLOAD_OK=1
        fi
    fi

    if [ "$DOWNLOAD_OK" -eq 1 ] && [ -s "$TMP_FILE" ]; then
        if grep -q 'VERSION=' "$TMP_FILE"; then
            local NEW_VERSION
            NEW_VERSION=$(grep -m 1 'VERSION=' "$TMP_FILE" | cut -d '"' -f 2)
            cp -f "$TMP_FILE" "$TARGET_FILE" 2>/dev/null || mv -f "$TMP_FILE" "$TARGET_FILE"
            chmod +x "$TARGET_FILE" 2>/dev/null || true
            rm -f "$TMP_FILE" 2>/dev/null || true
            echo -e "${GREEN}[✔] ¡Anime-CMD actualizado exitosamente a la versión ${BOLD}v${NEW_VERSION}${NC}${GREEN}!${NC}"
            echo ""
            exit 0
        else
            rm -f "$TMP_FILE" 2>/dev/null || true
            echo -e "${RED}[ERROR] La descarga no contiene una versión válida de Anime-CMD.${NC}"
            exit 1
        fi
    else
        rm -f "$TMP_FILE" 2>/dev/null || true
        echo -e "${RED}[ERROR] No se pudo conectar con el repositorio para actualizar.${NC}"
        exit 1
    fi
}

# Parseo de argumentos
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -v|--version)
            show_version
            exit 0
            ;;
        -u|-U|--update)
            update_anime
            exit 0
            ;;
        -c|--continue)
            CONTINUE=1
            ;;
        -s|--sub)
            AUDIO_PREF="sub"
            ;;
        -hh)
            EASTER_EGG=1
            ;;
        *)
            break
            ;;
    esac
    shift
done

arg1="$*"

# Detectar intérprete de Python disponible con prioridad para el que tenga librerías
PY_CMD=""
for cand in python python3 py; do
    if command -v "$cand" &> /dev/null; then
        if "$cand" -c "import curl_cffi" &> /dev/null; then
            PY_CMD="$cand"
            break
        elif [ -z "$PY_CMD" ]; then
            PY_CMD="$cand"
        fi
    fi
done

detect_env() {
    if [[ "$OSTYPE" == "msys" ]] || [[ "$OSTYPE" == "cygwin" ]] || grep -qi microsoft /proc/version 2>/dev/null || [ -n "$WSL_DISTRO_NAME" ]; then
        echo "wsl"
    elif [ -n "$PREFIX" ] && [[ "$PREFIX" == *com.termux* ]]; then
        echo "termux"
    else
        echo "linux"
    fi
}

find_fzf_cmd() {
    # 1. Probar fzf en PATH (verificando que ejecute sin error de shim)
    if command -v fzf >/dev/null 2>&1; then
        if fzf --version >/dev/null 2>&1; then
            echo "fzf"
            return
        fi
    fi
    if command -v fzf.exe >/dev/null 2>&1; then
        if fzf.exe --version >/dev/null 2>&1; then
            echo "fzf.exe"
            return
        fi
    fi

    # 2. Rutas conocidas de Scoop, WinGet, Chocolatey y sistema
    local candidates=(
        "$HOME/.anime/fzf.exe"
        "$HOME/scoop/apps/fzf/current/fzf.exe"
        "$USERPROFILE/scoop/apps/fzf/current/fzf.exe"
        "/c/Users/$USER/scoop/apps/fzf/current/fzf.exe"
        "$HOME/scoop/shims/fzf.exe"
        "$USERPROFILE/scoop/shims/fzf.exe"
        "/c/Users/$USER/scoop/shims/fzf.exe"
        "$LOCALAPPDATA/Microsoft/WinGet/Links/fzf.exe"
        "/c/ProgramData/chocolatey/bin/fzf.exe"
        "/usr/bin/fzf"
        "/usr/local/bin/fzf"
    )

    for cand in "${candidates[@]}"; do
        if [ -n "$cand" ] && [ -f "$cand" ]; then
            if "$cand" --version >/dev/null 2>&1; then
                echo "$cand"
                return
            fi
        fi
    done

    echo ""
}

# Auto-reparación y resolución transparente de FZF
FZF_BIN=$(find_fzf_cmd)

# Si ~/.anime/fzf.exe es un shim huérfano o está corrupto, auto-repararlo
if [ -f "$HOME/.anime/fzf.exe" ] && ! "$HOME/.anime/fzf.exe" --version >/dev/null 2>&1; then
    if [ -n "$FZF_BIN" ] && [ "$FZF_BIN" != "$HOME/.anime/fzf.exe" ] && [ -f "$FZF_BIN" ]; then
        cp -f "$FZF_BIN" "$HOME/.anime/fzf.exe" 2>/dev/null || rm -f "$HOME/.anime/fzf.exe" 2>/dev/null || true
    else
        rm -f "$HOME/.anime/fzf.exe" 2>/dev/null || true
    fi
    FZF_BIN=$(find_fzf_cmd)
fi

# Si fzf en PATH no funciona pero se encontró FZF_BIN, envolver en función de bash
if [ -n "$FZF_BIN" ]; then
    if ! fzf --version >/dev/null 2>&1; then
        fzf() {
            "$FZF_BIN" "$@"
        }
        export -f fzf 2>/dev/null || true
    fi
fi

find_mpv_cmd() {
    # 1. Probar mpv en PATH
    if command -v mpv >/dev/null 2>&1 && mpv --version >/dev/null 2>&1; then
        echo "mpv"
        return
    elif command -v mpv.exe >/dev/null 2>&1 && mpv.exe --version >/dev/null 2>&1; then
        echo "mpv.exe"
        return
    fi

    # 2. Rutas conocidas de Scoop, WinGet, Chocolatey y sistema
    local candidates=(
        "$HOME/.anime/mpv.exe"
        "$HOME/scoop/apps/mpv/current/mpv.exe"
        "$USERPROFILE/scoop/apps/mpv/current/mpv.exe"
        "/c/Users/$USER/scoop/apps/mpv/current/mpv.exe"
        "$HOME/scoop/shims/mpv.exe"
        "$USERPROFILE/scoop/shims/mpv.exe"
        "/c/Users/$USER/scoop/shims/mpv.exe"
        "$LOCALAPPDATA/Microsoft/WinGet/Links/mpv.exe"
        "$LOCALAPPDATA/Programs/mpv/mpv.exe"
        "/c/Program Files/mpv/mpv.exe"
        "C:/Program Files/mpv/mpv.exe"
        "/c/Program Files (x86)/mpv/mpv.exe"
        "C:/Program Files (x86)/mpv/mpv.exe"
        "/c/ProgramData/chocolatey/bin/mpv.exe"
        "/usr/bin/mpv"
        "/usr/local/bin/mpv"
    )

    for cand in "${candidates[@]}"; do
        if [ -n "$cand" ] && [ -f "$cand" ]; then
            if "$cand" --version >/dev/null 2>&1; then
                echo "$cand"
                return
            fi
        fi
    done

    echo ""
}

check_dependencies() {
    local script_name
    script_name=$(basename "$0")
    local missing=()

    # 1. Verificar Python
    if [ -z "$PY_CMD" ]; then
        missing+=("python (o python3)")
    fi

    # 2. Verificar FZF
    if [ -z "$FZF_BIN" ]; then
        missing+=("fzf")
    fi

    # 3. Verificar MPV (en Termux es opcional)
    local env_type
    env_type=$(detect_env)
    if [ "$env_type" != "termux" ]; then
        local mpv_bin
        mpv_bin=$(find_mpv_cmd)
        if [ -z "$mpv_bin" ]; then
            missing+=("mpv")
        fi
    fi

    # 4. Otras utilidades
    for cmd in "$@"; do
        if ! command -v "$cmd" &> /dev/null && ! command -v "$cmd.exe" &> /dev/null; then
            missing+=("$cmd")
        fi
    done

    if [ ${#missing[@]} -ne 0 ]; then
        echo -e "${YELLOW}[$script_name]${RED} Dependencias faltantes:${NC}"
        for pkg in "${missing[@]}"; do
            echo -e "${YELLOW}  - $pkg ${NC}"
        done
        echo -e "${GREEN}Ejecuta el instalador antes de usar este script.${NC}"
        exit 1
    fi
}

# ==============================================================================
# MOTOR DE BÚSQUEDA MULTI-PROVEEDOR CONCURRENTE CON FEEDBACK EN TIEMPO REAL
# ==============================================================================
search_animes() {
    local search_query="$1"
    local force_sub="$2"
    local is_easter_egg="${3:-0}"
    "$PY_CMD" - "$search_query" "$force_sub" "$is_easter_egg" <<'END_SEARCH'
import sys, re, urllib.parse, urllib.request, ssl, concurrent.futures, html
if hasattr(sys.stdout, 'reconfigure'):
    sys.stdout.reconfigure(encoding='utf-8', errors='replace')
if hasattr(sys.stderr, 'reconfigure'):
    sys.stderr.reconfigure(encoding='utf-8', errors='replace')

try:
    from bs4 import BeautifulSoup
except ImportError:
    BeautifulSoup = None

ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE

HEADERS = {
    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36',
    'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
    'Accept-Language': 'es-ES,es;q=0.9'
}

def fetch_html(url, timeout=5):
    try:
        req = urllib.request.Request(url, headers=HEADERS)
        return urllib.request.urlopen(req, timeout=timeout, context=ctx).read().decode('utf-8', errors='ignore')
    except Exception:
        return ""

def search_animeonline(query):
    results = []
    try:
        from curl_cffi import requests as c_requests
    except ImportError:
        c_requests = None
    if not c_requests:
        return results

    try:
        url = "https://ww3.animeonline.ninja/search/?s=" + urllib.parse.quote(query)
        r = c_requests.get(url, impersonate="chrome124", timeout=8)
        if r.status_code != 200:
            return results
        if BeautifulSoup:
            soup = BeautifulSoup(r.text, 'html.parser')
            for art in soup.select('.result-item article, article'):
                title_el = art.select_one('.title a, h3 a')
                if not title_el:
                    continue
                title = title_el.get_text(strip=True)
                href = title_el.get('href', '')
                if not href or '/episodio/' in href:
                    continue

                desc = art.select_one('.contenido, p')
                desc_text = desc.get_text(strip=True).lower() if desc else ""
                title_lower = title.lower()

                is_lat = "latino" in title_lower or "latino" in desc_text or "audio latino" in desc_text
                is_cast = "castellano" in title_lower or "castellano" in desc_text
                tag = '🔊 [LAT]' if is_lat else ('🇪🇸 [CAST]' if is_cast else '🇯🇵 [SUB]')
                results.append((tag, 'Anime Online', title, href, 'animeonline'))
        else:
            for m in re.finditer(r'<div class="title">\s*<a\s+href="([^"]+)">([^<]+)</a>', r.text):
                href, title = m.group(1), m.group(2).strip()
                if '/episodio/' in href:
                    continue
                is_lat = "latino" in title.lower()
                is_cast = "castellano" in title.lower()
                tag = '🔊 [LAT]' if is_lat else ('🇪🇸 [CAST]' if is_cast else '🇯🇵 [SUB]')
                results.append((tag, 'Anime Online', title, href, 'animeonline'))
    except Exception:
        pass
    return results

def search_tioanime(query):
    results = []
    queries = [query]
    if 'latino' not in query.lower():
        queries.append(query + ' latino')
    for q in queries:
        html = fetch_html('https://tioanime.com/directorio?q=' + urllib.parse.quote(q))
        if not html: continue
        if BeautifulSoup:
            soup = BeautifulSoup(html, 'html.parser')
            for item in soup.select('.anime article, article.anime, li.anime'):
                a = item.find('a', href=True)
                title_el = item.find(['h3', 'h2', 'span'], class_='title')
                if a and title_el:
                    title = title_el.get_text(strip=True)
                    href = 'https://tioanime.com' + a['href']
                    is_lat = bool(re.search(r'latino', title, re.I) or re.search(r'-latino/?$', href, re.I))
                    is_cast = bool(re.search(r'castellano', title, re.I) or re.search(r'-castellano/?$', href, re.I))
                    tag = '🔊 [LAT]' if is_lat else ('🇪🇸 [CAST]' if is_cast else '🇯🇵 [SUB]')
                    results.append((tag, 'TioAnime', title, href, 'tioanime'))
        else:
            for m in re.finditer(r'<a\s+href="(/anime/[^"]+)"[^>]*>.*?<h3 class="title">([^<]+)</h3>', html, re.DOTALL):
                href = 'https://tioanime.com' + m.group(1)
                title = m.group(2).strip()
                is_lat = bool(re.search(r'latino', title, re.I) or re.search(r'-latino/?$', href, re.I))
                is_cast = bool(re.search(r'castellano', title, re.I) or re.search(r'-castellano/?$', href, re.I))
                tag = '🔊 [LAT]' if is_lat else ('🇪🇸 [CAST]' if is_cast else '🇯🇵 [SUB]')
                results.append((tag, 'TioAnime', title, href, 'tioanime'))
    return results

def search_monoschinos(query):
    results = []
    queries = [query]
    if 'latino' not in query.lower():
        queries.append(query + ' latino')
    for q in queries:
        html = fetch_html('https://monoschinos2.com/buscar?q=' + urllib.parse.quote(q))
        if not html: continue
        if BeautifulSoup:
            soup = BeautifulSoup(html, 'html.parser')
            for a in soup.find_all('a', href=True):
                if '/anime/' in a['href']:
                    img = a.find('img', alt=True)
                    title_tag = a.find(['h3', 'h2', 'h4', 'h5', 'span', 'p'], class_=re.compile(r'title|name|nombre', re.I))
                    if title_tag and title_tag.get_text(strip=True):
                        title = title_tag.get_text(strip=True)
                    elif img and img.get('alt'):
                        title = img['alt'].strip()
                    else:
                        title = a.get_text(' ', strip=True)
                    title = re.sub(r'^(Anime|Pelicula|OVA|ONA|Donghua)\s*', '', title, flags=re.I).strip()
                    title = re.sub(r'\s*\b(19\d\d|20\d\d)\b.*$', '', title).strip()
                    title = ' '.join(title.split())
                    href = a['href']
                    if not href.startswith('http'):
                        href = 'https://monoschinos.st' + href
                    is_lat = bool(re.search(r'latino', title, re.I) or re.search(r'-audio-latino|-latino', href, re.I))
                    is_cast = bool(re.search(r'castellano', title, re.I) or re.search(r'-castellano', href, re.I))
                    tag = '🔊 [LAT]' if is_lat else ('🇪🇸 [CAST]' if is_cast else '🇯🇵 [SUB]')
                    results.append((tag, 'MonosChinos', title, href, 'monoschinos'))
        else:
            for m in re.finditer(r'<a\s+[^>]*href="(https?://monoschinos\.[^/]+/anime/[^"]+|/anime/[^"]+)"[^>]*>(.*?)</a>', html, re.DOTALL):
                href = m.group(1)
                if not href.startswith('http'):
                    href = 'https://monoschinos.st' + href
                content = m.group(2)
                title = re.sub(r'<[^>]+>', '', content).strip()
                title = re.sub(r'^(Anime|Pelicula|OVA|ONA|Donghua)\s*', '', title, flags=re.I).strip()
                title = re.sub(r'\s*\b(19\d\d|20\d\d)\b.*$', '', title).strip()
                title = ' '.join(title.split())
                if title:
                    is_lat = bool(re.search(r'latino', title, re.I) or re.search(r'-audio-latino|-latino', href, re.I))
                    is_cast = bool(re.search(r'castellano', title, re.I) or re.search(r'-castellano', href, re.I))
                    tag = '🔊 [LAT]' if is_lat else ('🇪🇸 [CAST]' if is_cast else '🇯🇵 [SUB]')
                    results.append((tag, 'MonosChinos', title, href, 'monoschinos'))
    return results

def search_jkanime(query):
    results = []
    queries = [query]
    if 'latino' not in query.lower():
        queries.append(query + ' latino')
    ignore_urls = {'https://jkanime.net/directorio/', 'https://jkanime.net/horario/', 'https://jkanime.net/estrenos/', 'https://jkanime.net/top/', 'https://jkanime.net/buscar/', 'https://jkanime.net/comunidad/', 'https://jkanime.net/aplicacion/', 'https://jkanime.net/historial/', 'https://jkanime.net/guardado/'}
    seen = set()
    for q in queries:
        html = fetch_html('https://jkanime.net/buscar/' + urllib.parse.quote(q.replace(' ', '_')) + '/')
        if not html: continue
        if BeautifulSoup:
            soup = BeautifulSoup(html, 'html.parser')
            for a in soup.find_all('a', href=True):
                href = a['href']
                if re.match(r'^https://jkanime\.net/[a-zA-Z0-9\-]+/$', href):
                    if href in ignore_urls or href in seen or a.find('div'):
                        continue
                    title = ' '.join(a.get_text(' ', strip=True).split())
                    if title and not re.match(r'^\d+\s*/', title):
                        seen.add(href)
                        is_lat = bool(re.search(r'latino', title, re.I) or re.search(r'-latino/?$', href, re.I))
                        is_cast = bool(re.search(r'castellano', title, re.I) or re.search(r'-castellano/?$', href, re.I))
                        if not is_lat and not is_cast:
                            title_clean = re.sub(r'[^a-zA-Z0-9\s]', '', title.lower()).strip()
                            if any(k in title_clean for k in ['dragon ball z', 'death note', 'inuyasha', 'ranma', 'sailor moon']):
                                is_lat = True
                        tag = '🔊 [LAT]' if is_lat else ('🇪🇸 [CAST]' if is_cast else '🇯🇵 [SUB]')
                        results.append((tag, 'JKAnime', title, href, 'jkanime'))
        else:
            for href, content in re.findall(r'<a[^>]+href=["\'](https://jkanime\.net/[a-zA-Z0-9\-]+/)["\'][^>]*>(.*?)</a>', html, re.DOTALL):
                if href in ignore_urls or href in seen or '<div' in content:
                    continue
                title = re.sub(r'<[^>]+>', '', content).strip()
                title = ' '.join(title.split())
                if title and not re.match(r'^\d+\s*/', title):
                    seen.add(href)
                    is_lat = bool(re.search(r'latino', title, re.I) or re.search(r'-latino/?$', href, re.I))
                    is_cast = bool(re.search(r'castellano', title, re.I) or re.search(r'-castellano/?$', href, re.I))
                    if not is_lat and not is_cast:
                        title_clean = re.sub(r'[^a-zA-Z0-9\s]', '', title.lower()).strip()
                        if any(k in title_clean for k in ['dragon ball z', 'death note', 'inuyasha', 'ranma', 'sailor moon']):
                            is_lat = True
                    tag = '🔊 [LAT]' if is_lat else ('🇪🇸 [CAST]' if is_cast else '🇯🇵 [SUB]')
                    results.append((tag, 'JKAnime', title, href, 'jkanime'))
    return results

