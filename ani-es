#!/bin/bash

VERSION="2.1.0"

CONTINUE=0
AUDIO_PREF="latino"
progress="00:00:00"

# Colores de texto ANSI
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[0;37m'
BOLD='\033[1m'
NC='\033[0m'

show_help() {
    echo ""
    echo -e "    ${GREEN}${BOLD}Uso:${NC} anime [opciones] [busqueda]"
    echo ""
    echo -e "    ${CYAN}${BOLD}Opciones:${NC}"
    echo "      -s, --sub        Forzar versión en japonés subtitulada [SUB]"
    echo "      -c, --continue   Continuar el anime en el último capítulo y minuto visto"
    echo "      -h, --help       Mostrar esta ayuda"
    echo "      -v, --version    Mostrar versión instalada"
    echo ""
    echo -e "    ${YELLOW}${BOLD}Características del motor v2.1:${NC}"
    echo -e "      • ${GREEN}Motor Multi-Proveedor:${NC} Búsqueda en paralelo (TioAnime, MonosChinos, JKAnime, AnimeFLV)."
    echo -e "      • ${GREEN}Prioridad Audio Latino:${NC} Reproduce por defecto doblaje latino con failover a subtitulado."
    echo -e "      • ${GREEN}Detección Inteligente:${NC} Detecta servidores dual-audio y enlaces alternativos de doblaje."
    echo ""
}

show_version() {
    echo -e "Anime-CMD ${PURPLE}v${VERSION}${NC} - Motor Agregador Multi-Plataforma"
}

# Parseo de argumentos
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -v|--version)
            show_version
            exit 0
            ;;
        -c|--continue)
            CONTINUE=1
            ;;
        -s|--sub)
            AUDIO_PREF="sub"
            ;;
        *)
            break
            ;;
    esac
    shift
done

arg1="$*"

# Detectar intérprete de Python disponible
if command -v python3 &> /dev/null; then
    PY_CMD="python3"
elif command -v python &> /dev/null; then
    PY_CMD="python"
elif command -v py &> /dev/null; then
    PY_CMD="py"
else
    PY_CMD=""
fi

detect_env() {
    if [[ "$OSTYPE" == "msys" ]] || [[ "$OSTYPE" == "cygwin" ]] || grep -qi microsoft /proc/version 2>/dev/null || [ -n "$WSL_DISTRO_NAME" ]; then
        echo "wsl"
    elif [ -n "$PREFIX" ] && [[ "$PREFIX" == *com.termux* ]]; then
        echo "termux"
    else
        echo "linux"
    fi
}

check_dependencies() {
    local script_name
    script_name=$(basename "$0")
    local missing=()

    # 1. Verificar Python
    if [ -z "$PY_CMD" ]; then
        missing+=("python (o python3)")
    fi

    # 2. Verificar FZF
    if ! command -v fzf &> /dev/null && ! command -v fzf.exe &> /dev/null; then
        missing+=("fzf")
    fi

    # 3. Verificar MPV (en Termux es opcional)
    local env_type
    env_type=$(detect_env)
    if [ "$env_type" != "termux" ]; then
        if ! command -v mpv &> /dev/null && ! command -v mpv.exe &> /dev/null; then
            missing+=("mpv")
        fi
    fi

    # 4. Otras utilidades
    for cmd in "$@"; do
        if ! command -v "$cmd" &> /dev/null && ! command -v "$cmd.exe" &> /dev/null; then
            missing+=("$cmd")
        fi
    done

    if [ ${#missing[@]} -ne 0 ]; then
        echo -e "${CYAN}[$script_name]${RED} Dependencias faltantes:${NC}"
        for pkg in "${missing[@]}"; do
            echo -e "${CYAN}  - $pkg ${NC}"
        done
        echo -e "${GREEN}Ejecuta el instalador antes de usar este script.${NC}"
        exit 1
    fi
}

# ==============================================================================
# MOTOR DE BÚSQUEDA MULTI-PROVEEDOR CONCURRENTE CON FEEDBACK EN TIEMPO REAL
# ==============================================================================
search_animes() {
    local search_query="$1"
    local force_sub="$2"
    "$PY_CMD" - "$search_query" "$force_sub" <<'END_SEARCH'
import sys, re, urllib.parse, urllib.request, ssl, concurrent.futures
if hasattr(sys.stdout, 'reconfigure'):
    sys.stdout.reconfigure(encoding='utf-8', errors='replace')
if hasattr(sys.stderr, 'reconfigure'):
    sys.stderr.reconfigure(encoding='utf-8', errors='replace')

try:
    from bs4 import BeautifulSoup
except ImportError:
    BeautifulSoup = None

ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE

HEADERS = {
    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36',
    'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
    'Accept-Language': 'es-ES,es;q=0.9'
}

def fetch_html(url, timeout=5):
    try:
        req = urllib.request.Request(url, headers=HEADERS)
        return urllib.request.urlopen(req, timeout=timeout, context=ctx).read().decode('utf-8', errors='ignore')
    except Exception:
        return ""

def search_tioanime(query):
    results = []
    queries = [query]
    if 'latino' not in query.lower():
        queries.append(query + ' latino')
    for q in queries:
        html = fetch_html('https://tioanime.com/directorio?q=' + urllib.parse.quote(q))
        if not html: continue
        if BeautifulSoup:
            soup = BeautifulSoup(html, 'html.parser')
            for item in soup.select('.anime article, article.anime, li.anime'):
                a = item.find('a', href=True)
                title_el = item.find(['h3', 'h2', 'span'], class_='title')
                if a and title_el:
                    title = title_el.get_text(strip=True)
                    href = 'https://tioanime.com' + a['href']
                    is_lat = bool(re.search(r'latino', title, re.I) or re.search(r'-latino/?$', href, re.I))
                    is_cast = bool(re.search(r'castellano', title, re.I) or re.search(r'-castellano/?$', href, re.I))
                    tag = '🔊 [LAT]' if is_lat else ('🇪🇸 [CAST]' if is_cast else '🇯🇵 [SUB]')
                    results.append((tag, '[TioAnime]', title, href, 'tioanime'))
        else:
            for m in re.finditer(r'<a\s+href="(/anime/[^"]+)"[^>]*>.*?<h3 class="title">([^<]+)</h3>', html, re.DOTALL):
                href = 'https://tioanime.com' + m.group(1)
                title = m.group(2).strip()
                is_lat = bool(re.search(r'latino', title, re.I) or re.search(r'-latino/?$', href, re.I))
                is_cast = bool(re.search(r'castellano', title, re.I) or re.search(r'-castellano/?$', href, re.I))
                tag = '🔊 [LAT]' if is_lat else ('🇪🇸 [CAST]' if is_cast else '🇯🇵 [SUB]')
                results.append((tag, '[TioAnime]', title, href, 'tioanime'))
    return results

def search_monoschinos(query):
    results = []
    queries = [query]
    if 'latino' not in query.lower():
        queries.append(query + ' latino')
    for q in queries:
        html = fetch_html('https://monoschinos2.com/buscar?q=' + urllib.parse.quote(q))
        if not html: continue
        if BeautifulSoup:
            soup = BeautifulSoup(html, 'html.parser')
            for a in soup.find_all('a', href=True):
                if '/anime/' in a['href']:
                    title_tag = a.find(['h3', 'h2', 'h4', 'h5', 'h1', 'p', 'div', 'span'], class_=re.compile(r'title|nombre', re.I))
                    title = title_tag.get_text(strip=True) if title_tag else a.get_text(strip=True)
                    href = a['href']
                    if not href.startswith('http'):
                        href = 'https://monoschinos.st' + href
                    is_lat = bool(re.search(r'latino', title, re.I) or re.search(r'-audio-latino|-latino', href, re.I))
                    is_cast = bool(re.search(r'castellano', title, re.I) or re.search(r'-castellano', href, re.I))
                    tag = '🔊 [LAT]' if is_lat else ('🇪🇸 [CAST]' if is_cast else '🇯🇵 [SUB]')
                    results.append((tag, '[MonosChinos]', title, href, 'monoschinos'))
        else:
            for m in re.finditer(r'<a\s+[^>]*href="(https?://monoschinos\.[^/]+/anime/[^"]+|/anime/[^"]+)"[^>]*>(.*?)</a>', html, re.DOTALL):
                href = m.group(1)
                if not href.startswith('http'):
                    href = 'https://monoschinos.st' + href
                content = m.group(2)
                title = re.sub(r'<[^>]+>', '', content).strip()
                if title:
                    is_lat = bool(re.search(r'latino', title, re.I) or re.search(r'-audio-latino|-latino', href, re.I))
                    is_cast = bool(re.search(r'castellano', title, re.I) or re.search(r'-castellano', href, re.I))
                    tag = '🔊 [LAT]' if is_lat else ('🇪🇸 [CAST]' if is_cast else '🇯🇵 [SUB]')
                    results.append((tag, '[MonosChinos]', title, href, 'monoschinos'))
    return results

def search_jkanime(query):
    results = []
    queries = [query]
    if 'latino' not in query.lower():
        queries.append(query + ' latino')
    ignore_urls = {'https://jkanime.net/directorio/', 'https://jkanime.net/horario/', 'https://jkanime.net/estrenos/', 'https://jkanime.net/top/', 'https://jkanime.net/buscar/', 'https://jkanime.net/comunidad/', 'https://jkanime.net/aplicacion/', 'https://jkanime.net/historial/', 'https://jkanime.net/guardado/'}
    seen = set()
    for q in queries:
        html = fetch_html('https://jkanime.net/buscar/' + urllib.parse.quote(q.replace(' ', '_')) + '/')
        if not html: continue
        if BeautifulSoup:
            soup = BeautifulSoup(html, 'html.parser')
            for a in soup.find_all('a', href=True):
                href = a['href']
                if re.match(r'^https://jkanime\.net/[a-zA-Z0-9\-]+/$', href):
                    if href in ignore_urls or href in seen or a.find('div'):
                        continue
                    title = ' '.join(a.get_text(' ', strip=True).split())
                    if title and not re.match(r'^\d+\s*/', title):
                        seen.add(href)
                        is_lat = bool(re.search(r'latino', title, re.I) or re.search(r'-latino/?$', href, re.I))
                        is_cast = bool(re.search(r'castellano', title, re.I) or re.search(r'-castellano/?$', href, re.I))
                        if not is_lat and not is_cast:
                            title_clean = re.sub(r'[^a-zA-Z0-9\s]', '', title.lower()).strip()
                            if any(k in title_clean for k in ['dragon ball z', 'death note', 'inuyasha', 'ranma', 'sailor moon']):
                                is_lat = True
                        tag = '🔊 [LAT]' if is_lat else ('🇪🇸 [CAST]' if is_cast else '🇯🇵 [SUB]')
                        results.append((tag, '[JKAnime]', title, href, 'jkanime'))
        else:
            for href, content in re.findall(r'<a[^>]+href=["\'](https://jkanime\.net/[a-zA-Z0-9\-]+/)["\'][^>]*>(.*?)</a>', html, re.DOTALL):
                if href in ignore_urls or href in seen or '<div' in content:
                    continue
                title = re.sub(r'<[^>]+>', '', content).strip()
                title = ' '.join(title.split())
                if title and not re.match(r'^\d+\s*/', title):
                    seen.add(href)
                    is_lat = bool(re.search(r'latino', title, re.I) or re.search(r'-latino/?$', href, re.I))
                    is_cast = bool(re.search(r'castellano', title, re.I) or re.search(r'-castellano/?$', href, re.I))
                    if not is_lat and not is_cast:
                        title_clean = re.sub(r'[^a-zA-Z0-9\s]', '', title.lower()).strip()
                        if any(k in title_clean for k in ['dragon ball z', 'death note', 'inuyasha', 'ranma', 'sailor moon']):
                            is_lat = True
                    tag = '🔊 [LAT]' if is_lat else ('🇪🇸 [CAST]' if is_cast else '🇯🇵 [SUB]')
                    results.append((tag, '[JKAnime]', title, href, 'jkanime'))
    return results

def search_animeflv(query):
    results = []
    queries = [query]
    if 'latino' not in query.lower():
        queries.append(query + ' latino')
    for q in queries:
        html = fetch_html('https://www3.animeflv.net/browse?q=' + urllib.parse.quote(q))
        if not html: continue
        if BeautifulSoup:
            soup = BeautifulSoup(html, 'html.parser')
            for item in soup.select('ul.ListAnimes li article'):
                a = item.find('a', href=True)
                title_el = item.find('h3', class_='Title')
                if a and title_el:
                    title = title_el.get_text(strip=True)
                    href = 'https://www3.animeflv.net' + a['href']
                    is_lat = bool(re.search(r'latino', title, re.I) or re.search(r'-latino/?$', href, re.I))
                    is_cast = bool(re.search(r'castellano', title, re.I) or re.search(r'-castellano/?$', href, re.I))
                    tag = '🔊 [LAT]' if is_lat else ('🇪🇸 [CAST]' if is_cast else '🇯🇵 [SUB]')
                    results.append((tag, '[AnimeFLV]', title, href, 'animeflv'))
        else:
            for href, title in re.findall(r'<a\s+href="(/anime/[^"]+)"[^>]*>.*?<h3 class="Title">([^<]+)</h3>', html, re.DOTALL):
                href = 'https://www3.animeflv.net' + href
                is_lat = bool(re.search(r'latino', title, re.I) or re.search(r'-latino/?$', href, re.I))
                is_cast = bool(re.search(r'castellano', title, re.I) or re.search(r'-castellano/?$', href, re.I))
                tag = '🔊 [LAT]' if is_lat else ('🇪🇸 [CAST]' if is_cast else '🇯🇵 [SUB]')
                results.append((tag, '[AnimeFLV]', title.strip(), href, 'animeflv'))
    return results

query = sys.argv[1]
force_sub = sys.argv[2] == "sub"

sys.stderr.write(f"\033[0;36m[~] Consultando servidores multi-plataforma para '{query}'...\033[0m\n")

all_results = []
with concurrent.futures.ThreadPoolExecutor(max_workers=4) as executor:
    futures = {
        executor.submit(search_tioanime, query): 'TioAnime',
        executor.submit(search_jkanime, query): 'JKAnime',
        executor.submit(search_monoschinos, query): 'MonosChinos',
        executor.submit(search_animeflv, query): 'AnimeFLV',
    }
    for future in concurrent.futures.as_completed(futures):
        prov = futures[future]
        try:
            res = future.result()
            all_results.extend(res)
            sys.stderr.write(f"  \033[0;32m✔ {prov:<12}\033[0m ({len(res)} títulos)\n")
        except Exception:
            sys.stderr.write(f"  \033[0;31m✖ {prov:<12}\033[0m (Error de conexión)\n")

seen_keys = set()
deduped = []
for item in all_results:
    tag, prov, title, href, p_id = item
    key = (title.lower(), p_id)
    if key not in seen_keys:
        seen_keys.add(key)
        deduped.append(item)

if force_sub:
    def sort_key(item):
        tag, prov, title, href, p_id = item
        prio = 0 if 'SUB' in tag else (1 if 'LAT' in tag else 2)
        return (prio, title)
else:
    def sort_key(item):
        tag, prov, title, href, p_id = item
        prio = 0 if 'LAT' in tag else (1 if 'CAST' in tag else 2)
        return (prio, title)

deduped.sort(key=sort_key)
lat_count = sum(1 for item in deduped if 'LAT' in item[0])
sys.stderr.write(f"\033[0;32m[+] Total:\033[0m {len(deduped)} animes encontrados ({lat_count} con Audio Latino 🔊)\n\n")

for tag, prov, title, href, p_id in deduped:
    print(f"{tag} {prov:<13} {title}|{href}|{p_id}")
END_SEARCH
}

# ==============================================================================
# OBTENCIÓN DE METADATOS Y EPISODIOS
# ==============================================================================
get_anime_metadata() {
    local anime_url="$1"
    local provider="$2"
    "$PY_CMD" - "$anime_url" "$provider" <<'END_META'
import sys, re, json, urllib.request, http.cookiejar, ssl
if hasattr(sys.stdout, 'reconfigure'):
    sys.stdout.reconfigure(encoding='utf-8', errors='replace')

anime_url = sys.argv[1]
provider = sys.argv[2] if len(sys.argv) > 2 else "jkanime"

ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE

cj = http.cookiejar.CookieJar()
opener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(cj), urllib.request.HTTPSHandler(context=ctx))
opener.addheaders = [('User-Agent', 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36')]

try:
    resp = opener.open(anime_url, timeout=7)
    html = resp.read().decode('utf-8', errors='ignore')
except Exception:
    print("1|Serie|{}".format(anime_url))
    sys.exit(0)

tipo = "Serie"
total_episodes = 1

if provider == 'tioanime':
    m_ep = re.search(r'var episodes = (\[.*?\]);', html)
    if m_ep:
        try:
            eps = json.loads(m_ep.group(1))
            total_episodes = max(eps) if eps else 1
        except Exception:
            pass
    if re.search(r'tipo-pelicula|pelicula', html, re.I):
        tipo = "Pelicula"

elif provider == 'animeflv':
    m_ep = re.search(r'var episodes = (\[\[.*?\]\]);', html)
    if m_ep:
        try:
            eps = json.loads(m_ep.group(1))
            total_episodes = eps[0][0] if eps else 1
        except Exception:
            pass
    m_tipo = re.search(r'<span>Tipo:</span>\s*([^<]+)', html, re.I)
    if m_tipo:
        tipo = m_tipo.group(1).strip()

elif provider == 'jkanime':
    m_tipo = re.search(r'<span>Tipo:</span>\s*([^<]+)', html, re.I)
    if m_tipo:
        tipo = m_tipo.group(1).strip()
    m_id = re.search(r'ajax/(?:episodes|reportar_trailer|votado)/(\d+)', html)
    if m_id:
        try:
            anime_id = m_id.group(1)
            csrf_m = re.search(r'name="csrf-token"\s+content="([^"]+)"', html)
            csrf_token = csrf_m.group(1) if csrf_m else ""
            ajax_url = "https://jkanime.net/ajax/episodes/{}/1".format(anime_id)
            post_data = "_token={}".format(csrf_token).encode('utf-8')
            ajax_req = urllib.request.Request(ajax_url, data=post_data, headers={
                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)',
                'X-Requested-With': 'XMLHttpRequest',
                'X-CSRF-TOKEN': csrf_token,
                'Referer': anime_url
            })
            ajax_resp = opener.open(ajax_req, timeout=5)
            data_str = ajax_resp.read().decode('utf-8', errors='ignore')
            js = json.loads(data_str)
            total_episodes = js.get("total", 1)
        except Exception:
            pass
    if total_episodes == 1:
        ep_nums = [int(n) for n in re.findall(r'href=["\']' + re.escape(anime_url.rstrip('/') + '/') + r'(\d+)/?["\']', html)]
        if ep_nums:
            total_episodes = max(ep_nums)

elif provider == 'monoschinos':
    ep_nums = [int(n) for n in re.findall(r'episodio-(\d+)', html)]
    if ep_nums:
        total_episodes = max(ep_nums)
    if re.search(r'pelicula', anime_url, re.I) or re.search(r'pelicula', html, re.I):
        tipo = "Pelicula"

print("{}|{}|{}".format(total_episodes, tipo, anime_url))
END_META
}

# ==============================================================================
# EXTRACTOR UNIVERSAL DE STREAMS CON FAILOVER INTELIGENTE Y SELECCIÓN DE AUDIO
# ==============================================================================
extract_stream() {
    local anime_url="$1"
    local provider="$2"
    local episode_num="$3"
    local pref_audio="$4"
    "$PY_CMD" - "$anime_url" "$provider" "$episode_num" "$pref_audio" <<'END_STREAM'
import sys, re, json, base64, urllib.request, ssl
if hasattr(sys.stdout, 'reconfigure'):
    sys.stdout.reconfigure(encoding='utf-8', errors='replace')

anime_url = sys.argv[1]
provider = sys.argv[2] if len(sys.argv) > 2 else "jkanime"
episode_num = str(sys.argv[3]) if len(sys.argv) > 3 else "1"
pref_audio = sys.argv[4] if len(sys.argv) > 4 else "latino"

ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE

HEADERS = {
    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36',
    'Accept': '*/*'
}

def fetch_html(url, timeout=5, referer=None):
    headers = dict(HEADERS)
    if referer:
        headers['Referer'] = referer
    try:
        req = urllib.request.Request(url, headers=headers)
        return urllib.request.urlopen(req, timeout=timeout, context=ctx).read().decode('utf-8', errors='ignore')
    except Exception:
        return None

def resolve_direct_stream(url, referer=None):
    if not url:
        return None
    url_lower = url.lower()

    if '.m3u8' in url_lower or '.mp4' in url_lower:
        return url

    html = fetch_html(url, timeout=5, referer=referer)
    if not html:
        if any(k in url_lower for k in ['ok.ru', 'mega.nz', 'streamtape.com', 'filemoon', 'vidhide']):
            return url
        return None

    # 1. Mediafire
    if 'mediafire.com' in url_lower:
        m = re.search(r'href=[\"\'](https?://download[^\'\"]+)[\"\']', html)
        if m: return m.group(1)
        m = re.search(r'aria-label=[\"\']Download file[\"\']\s+href=[\"\']([^\"\']+)[\"\']', html)
        if m: return m.group(1)

    # 2. Mp4upload
    if 'mp4upload.com' in url_lower:
        m = re.search(r'src:\s*[\"\'](https?://[^\'\"]+\.mp4)[\"\']', html)
        if m: return m.group(1)
        m = re.search(r'<source\s+src=[\"\'](https?://[^\'\"]+\.mp4)[\"\']', html)
        if m: return m.group(1)

    # 3. YourUpload
    if 'yourupload.com' in url_lower:
        m = re.search(r'file:\s*[\"\'](https?://[^\'\"]+\.mp4[^\'\"]*)[\"\']', html)
        if m: return m.group(1)
        m = re.search(r'data-url=[\"\']([^\"\']+\.mp4[^\'\"]*)[\"\']', html)
        if m: return m.group(1)

    # 4. Voe.sx
    if 'voe.sx' in url_lower or 'voe-' in url_lower:
        m = re.search(r'[\"\']hls[\"\']\s*:\s*[\"\'](https?://[^\'\"]+)[\"\']', html)
        if m: return m.group(1)
        m = re.search(r'[\"\']mp4[\"\']\s*:\s*[\"\'](https?://[^\'\"]+)[\"\']', html)
        if m: return m.group(1)
        m = re.search(r'window\.location\.href\s*=\s*[\"\'](https?://[^\'\"]+)[\"\']', html)
        if m: return resolve_direct_stream(m.group(1), referer=url)

    # 5. Streamwish / swdyu / sfastwish
    if any(k in url_lower for k in ['streamwish', 'swdyu', 'sfastwish', 'wishfast', 'wishembed', 'strwish']):
        m = re.search(r'sources:\s*\[\{\s*file:\s*[\"\'](https?://[^\'\"]+)[\"\']', html)
        if m: return m.group(1)
        m = re.search(r'file:\s*[\"\'](https?://[^\'\"]+\.m3u8[^\'\"]*)[\"\']', html)
        if m: return m.group(1)

    # 6. HTML5 tags
    m = re.search(r'<source\s+[^>]*src=[\"\'](https?://[^\'\"]+)[\"\']', html)
    if m: return m.group(1)

    m = re.search(r'hls\.loadSource\(\s*[\"\'](https?://[^\'\"]+)[\"\']\s*\)', html)
    if m: return m.group(1)

    if any(k in url_lower for k in ['ok.ru', 'mega.nz', 'streamtape.com', 'filemoon', 'vidhide', 'doodstream', 'uqload']):
        return url

    return None

def extract():
    # 1. JKAnime
    if provider == 'jkanime':
        ep_url = anime_url.rstrip('/') + '/' + episode_num + '/'
        html = fetch_html(ep_url)
        if not html:
            return None, "sub"
        
        target_lang = "3" if pref_audio == "latino" else "1"
        fallback_lang = "1" if pref_audio == "latino" else "3"
        
        m_servers = re.search(r'var servers = (\[.*?\]);', html, re.DOTALL)
        if m_servers:
            try:
                servers_json = json.loads(m_servers.group(1))
                target_servers = [s for s in servers_json if str(s.get('lang')) == target_lang]
                is_lat = bool(target_servers) if target_lang == "3" else False
                if not target_servers:
                    target_servers = [s for s in servers_json if str(s.get('lang')) == fallback_lang]
                if not target_servers:
                    target_servers = servers_json
                
                lang_tag = "latino" if is_lat else "sub"
                
                for s in target_servers:
                    remote_b64 = s.get('remote', '')
                    if remote_b64:
                        try:
                            decoded_url = base64.b64decode(remote_b64).decode('utf-8').strip()
                            resolved = resolve_direct_stream(decoded_url, referer=ep_url)
                            if resolved:
                                return resolved, lang_tag
                        except Exception:
                            pass
            except Exception:
                pass
                
        player_urls = re.findall(r'src=["\'](https://jkanime\.net/jkplayer/[^"\']+)["\']', html)
        for p_url in player_urls:
            try:
                p_html = fetch_html(p_url, referer=ep_url)
                if p_html:
                    m_vid = re.search(r'video:\s*\{[^}]*url:\s*[\'\"]([^\'\"]+)[\'\"]', p_html)
                    if m_vid:
                        return m_vid.group(1), ("latino" if "latino" in ep_url else "sub")
                    m_hls = re.search(r'hls\.loadSource\(\s*[\'\"]([^\'\"]+)[\'\"]\s*\)', p_html)
                    if m_hls:
                        return m_hls.group(1), ("latino" if "latino" in ep_url else "sub")
            except Exception:
                pass

    # 2. TioAnime
    elif provider == 'tioanime':
        slug = anime_url.rstrip('/').split('/')[-1]
        slug_base = re.sub(r'-(?:latino|castellano)$', '', slug)
        
        urls_to_try = []
        if pref_audio == "latino":
            urls_to_try.append(('https://tioanime.com/ver/{}-latino-{}'.format(slug_base, episode_num), 'latino'))
            urls_to_try.append(('https://tioanime.com/ver/{}-{}'.format(slug, episode_num), 'latino' if 'latino' in slug else 'sub'))
        else:
            urls_to_try.append(('https://tioanime.com/ver/{}-{}'.format(slug_base, episode_num), 'sub'))

        for ep_url, lang_tag in urls_to_try:
            html = fetch_html(ep_url)
            if not html:
                continue
            m_vids = re.search(r'var videos = (\[.*?\]);', html)
            if m_vids:
                try:
                    videos = json.loads(m_vids.group(1))
                    def srv_score(s):
                        v = str(s[1]).lower()
                        if 'yourupload' in v: return 1
                        if 'mp4upload' in v: return 2
                        if 'voe' in v: return 3
                        if 'streamwish' in v: return 4
                        if 'ok.ru' in v: return 5
                        if 'mega' in v: return 6
                        return 10
                        
                    videos.sort(key=srv_score)
                    for s in videos:
                        if len(s) > 1:
                            resolved = resolve_direct_stream(s[1], referer=ep_url)
                            if resolved:
                                return resolved, lang_tag
                except Exception:
                    pass

    # 3. MonosChinos
    elif provider == 'monoschinos':
        slug = anime_url.rstrip('/').split('/')[-1]
        slug_base = re.sub(r'-(?:sub-espanol|audio-latino|castellano)$', '', slug)
        
        urls_to_try = []
        if pref_audio == "latino":
            urls_to_try.append(('https://monoschinos.st/ver/{}-audio-latino-episodio-{}'.format(slug_base, episode_num), 'latino'))
            urls_to_try.append(('https://monoschinos.st/ver/{}-episodio-{}'.format(slug, episode_num), 'latino' if 'latino' in slug else 'sub'))
        else:
            urls_to_try.append(('https://monoschinos.st/ver/{}-episodio-{}'.format(slug_base, episode_num), 'sub'))

        for ep_url, lang_tag in urls_to_try:
            html = fetch_html(ep_url)
            if not html:
                continue
            m_btns = re.findall(r'data-player=["\']([^"\']+)["\']', html)
            decoded_servers = []
            for b in m_btns:
                try:
                    dec = base64.b64decode(b).decode('utf-8', errors='ignore').strip()
                    if dec.startswith('http'):
                        decoded_servers.append(dec)
                except Exception:
                    pass
                    
            def mc_srv_score(u):
                u_l = u.lower()
                if 'mp4upload' in u_l: return 1
                if 'yourupload' in u_l: return 2
                if 'voe.sx' in u_l: return 3
                if 'streamwish' in u_l or 'swdyu' in u_l: return 4
                if 'filemoon' in u_l: return 5
                if 'ok.ru' in u_l: return 6
                if 'uqload' in u_l: return 7
                return 10
                
            decoded_servers.sort(key=mc_srv_score)
            for srv in decoded_servers:
                resolved = resolve_direct_stream(srv, referer=ep_url)
                if resolved:
                    return resolved, lang_tag

    # 4. AnimeFLV
    elif provider == 'animeflv':
        slug = anime_url.rstrip('/').split('/')[-1]
        slug_base = re.sub(r'-(?:latino|tv-audio-latino|castellano)$', '', slug)
        
        urls_to_try = []
        if pref_audio == "latino":
            urls_to_try.append(('https://www3.animeflv.net/ver/{}-latino-{}'.format(slug_base, episode_num), 'latino'))
            urls_to_try.append(('https://www3.animeflv.net/ver/{}-{}'.format(slug, episode_num), 'latino' if 'latino' in slug else 'sub'))
        else:
            urls_to_try.append(('https://www3.animeflv.net/ver/{}-{}'.format(slug_base, episode_num), 'sub'))

        for ep_url, lang_tag in urls_to_try:
            html = fetch_html(ep_url)
            if not html:
                continue
            for a_m in re.finditer(r'<a[^>]+href=["\'](https?://[^"\']+)["\'][^>]*>(.*?)</a>', html):
                h = a_m.group(1)
                if any(k in h.lower() for k in ['yourupload', 'streamwish', 'swdyu', 'mega.nz', 'mediafire', 'mp4upload', 'ok.ru']):
                    resolved = resolve_direct_stream(h, referer=ep_url)
                    if resolved:
                        return resolved, lang_tag

    return None, "sub"

stream, lang = extract()
if stream:
    print("{}|{}".format(stream, lang))
else:
    sys.exit(1)
END_STREAM
}

