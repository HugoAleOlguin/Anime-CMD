                if pm list packages | grep -q 'org.videolan.vlc'; then
                    am start -a android.intent.action.VIEW -d "$src_contenido" -n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity
                    pos=0
                else
                    termux-open-url "$src_contenido"
                    pos=0
                fi
                ;;
            linux)
                if command -v mpv >/dev/null 2>&1; then
                    pos=$(mpv --cache=yes --demuxer-max-bytes=150M --demuxer-readahead-secs=300 --start=$progress -v --msg-level=ffmpeg=no --force-media-title="${title_prefix} ${clean_title} - Capítulo ${ep_num}" "$src_contenido" | grep -oE 'AV: [0-9]{2}:[0-9]{2}:[0-9]{2}' | tail -n 1 | sed 's/AV: //g' 2>&1)
                elif command -v mpv.exe >/dev/null 2>&1; then
                    pos=$(mpv.exe --cache=yes --demuxer-max-bytes=150M --demuxer-readahead-secs=300 --start=$progress -v --msg-level=ffmpeg=no --force-media-title="${title_prefix} ${clean_title} - Capítulo ${ep_num}" "$src_contenido" | grep -oE 'AV: [0-9]{2}:[0-9]{2}:[0-9]{2}' | tail -n 1 | sed 's/AV: //g' 2>&1)
                fi
                ;;
        esac

        # Actualizar historial SQLite
        "$PY_CMD" - "$clean_title" "$nuevaurl" "$provider" "$ep_num" "$pos" <<'END_HIST'
