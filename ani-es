#!/bin/bash

VERSION="1.4.0"

CONTINUE=0
progress="00:00:00"

# Colores de texto
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[0;37m'
NC='\033[0m'

show_help() {
    echo ""
    echo "    Uso: anime [opciones] [busqueda]"
    echo ""
    echo "    Opciones:"
    echo "      -h, --help       Mostrar esta ayuda"
    echo "      -v, --version    Mostrar versión instalada"
    echo "      -c, --continue   Continuar el anime en el último capítulo y minuto visto"
    echo ""
}

show_version() {
    echo -e "Anime-CMD ${PURPLE}v${VERSION}${NC}"
}

# Parseo de argumentos
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -v|--version)
            show_version
            exit 0
            ;;
        -c|--continue)
            CONTINUE=1
            ;;
        *)
            break
            ;;
    esac
    shift
done

arg1="$*"

check_dependencies() {
    local script_name
    script_name=$(basename "$0")
    local missing=()

    for cmd in "$@"; do
        if ! command -v "$cmd" &> /dev/null; then
            missing+=("$cmd")
        fi
    done

    if [ ${#missing[@]} -ne 0 ]; then
        echo -e "${CYAN}[$script_name]${RED} Dependencias faltantes:${NC}"
        for pkg in "${missing[@]}"; do
            echo -e "${CYAN}  - $pkg ${NC}"
        done
        echo -e "${GREEN}Ejecuta el instalador antes de usar este script.${NC}"
        exit 1
    fi
}

detect_env() {
    if [[ "$OSTYPE" == "msys" ]] || [[ "$OSTYPE" == "cygwin" ]] || grep -qi microsoft /proc/version 2>/dev/null || [ -n "$WSL_DISTRO_NAME" ]; then
        echo "wsl"
    elif [ -n "$PREFIX" ] && [[ "$PREFIX" == *com.termux* ]]; then
        echo "termux"
    else
        echo "linux"
    fi
}

search_animes() {
    local search_query="$1"
    python3 - "$search_query" <<'END_SEARCH'
import sys, re, urllib.parse, urllib.request
try:
    from bs4 import BeautifulSoup
except ImportError:
    BeautifulSoup = None

query = sys.argv[1]
encoded_query = urllib.parse.quote(query.replace(' ', '_'))
url = f"https://jkanime.net/buscar/{encoded_query}/"

req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)'})
try:
    html = urllib.request.urlopen(req).read().decode('utf-8', errors='ignore')
except Exception:
    sys.exit(0)

ignore_urls = {
    "https://jkanime.net/directorio/",
    "https://jkanime.net/horario/",
    "https://jkanime.net/estrenos/",
    "https://jkanime.net/top/",
    "https://jkanime.net/buscar/",
    "https://jkanime.net/comunidad/",
    "https://jkanime.net/aplicacion/",
    "https://jkanime.net/historial/",
    "https://jkanime.net/guardado/"
}

seen = set()
results = []

if BeautifulSoup:
    soup = BeautifulSoup(html, 'html.parser')
    for a in soup.find_all('a', href=True):
        href = a['href']
        if re.match(r'^https://jkanime\.net/[a-zA-Z0-9\-]+/$', href):
            if href in ignore_urls or href in seen or a.find('div'):
                continue
            title = a.get_text(" ", strip=True)
            title = " ".join(title.split())
            if title and not re.match(r'^\d+\s*/', title):
                seen.add(href)
                results.append((title, href))
else:
    pattern = r'<a[^>]+href=["\'](https://jkanime\.net/[a-zA-Z0-9\-]+/)["\'][^>]*>(.*?)</a>'
    matches = re.findall(pattern, html, re.DOTALL)
    for href, content in matches:
        if href in ignore_urls or href in seen or '<div' in content:
            continue
        title = re.sub(r'<[^>]+>', '', content).strip()
        title = " ".join(title.split())
        if title and not re.match(r'^\d+\s*/', title):
            seen.add(href)
            results.append((title, href))

for title, href in results:
    print(f"{title}|{href}")
END_SEARCH
}

get_anime_metadata() {
    local anime_url="$1"
    python3 - "$anime_url" <<'END_META'
import sys, re, json, urllib.request, http.cookiejar

anime_url = sys.argv[1]
if not anime_url.endswith('/'):
    anime_url += '/'

cj = http.cookiejar.CookieJar()
opener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(cj))
opener.addheaders = [('User-Agent', 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)')]

try:
    resp = opener.open(anime_url)
    html = resp.read().decode('utf-8', errors='ignore')
except Exception:
    print("1|Serie")
    sys.exit(0)

# Verificar tipo (Película vs Serie)
tipo_m = re.search(r'<span>Tipo:</span>\s*([^<]+)', html, re.I)
tipo = tipo_m.group(1).strip() if tipo_m else "Serie"

# Obtener anime_id
m_id = re.search(r'ajax/episodes/(\d+)/', html)
if m_id:
    anime_id = m_id.group(1)
    csrf_m = re.search(r'name="csrf-token" content="([^"]+)"', html)
    csrf_token = csrf_m.group(1) if csrf_m else ""
    ajax_url = f"https://jkanime.net/ajax/episodes/{anime_id}/1"
    post_data = f"_token={csrf_token}".encode('utf-8')
    ajax_req = urllib.request.Request(ajax_url, data=post_data, headers={
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)',
        'X-Requested-With': 'XMLHttpRequest',
        'X-CSRF-TOKEN': csrf_token,
        'Referer': anime_url
    })
    try:
        ajax_resp = opener.open(ajax_req)
        data = ajax_resp.read().decode('utf-8', errors='ignore')
        js = json.loads(data)
        total = js.get("total", 1)
        print(f"{total}|{tipo}")
        sys.exit(0)
    except Exception:
        pass

# Fallback: verificar el enlace con número de episodio más alto
ep_nums = [int(n) for n in re.findall(r'href=[\"\']' + re.escape(anime_url) + r'(\d+)/?[\"\']', html)]
total = max(ep_nums) if ep_nums else 1
print(f"{total}|{tipo}")
END_META
}

extract_stream() {
    local episode_url="$1"
    python3 - "$episode_url" <<'END_STREAM'
import sys, re, json, base64, urllib.request

episode_url = sys.argv[1]
req = urllib.request.Request(episode_url, headers={
    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36'
})
try:
    html = urllib.request.urlopen(req).read().decode('utf-8', errors='ignore')
except Exception:
    sys.exit(1)

# PRIORIDAD 1: Buscar servidores con Audio Latino (lang == 3)
m_servers = re.search(r'var servers = (\[.*?\]);', html, re.DOTALL)
if m_servers:
    try:
        servers_json = json.loads(m_servers.group(1))
        # Filtrar servidores en Audio Latino (lang = 3)
        latino_servers = [s for s in servers_json if str(s.get('lang')) == '3']
        target_servers = latino_servers if latino_servers else servers_json

        for s in target_servers:
            remote_b64 = s.get('remote', '')
            if remote_b64:
                try:
                    decoded_url = base64.b64decode(remote_b64).decode('utf-8').strip()
                    # Enlace directo de Mediafire
                    if "mediafire.com" in decoded_url.lower():
                        mf_req = urllib.request.Request(decoded_url, headers={'User-Agent': 'Mozilla/5.0'})
                        mf_html = urllib.request.urlopen(mf_req).read().decode('utf-8', errors='ignore')
                        mf_m = re.search(r'href=[\"\'](https://download[^\'\"]+)[\"\']', mf_html)
                        if mf_m:
                            print(mf_m.group(1))
                            sys.exit(0)
                    
                    # Enlace directo de Mp4upload
                    if "mp4upload.com" in decoded_url.lower():
                        mp4_req = urllib.request.Request(decoded_url, headers={'User-Agent': 'Mozilla/5.0'})
                        mp4_html = urllib.request.urlopen(mp4_req).read().decode('utf-8', errors='ignore')
                        src_m = re.search(r'src:\s*[\"\'](https://[^\'\"]+\.mp4)[\"\']', mp4_html)
                        if src_m:
                            print(src_m.group(1))
                            sys.exit(0)

                    # Servidores de streaming compatibles directamente con MPV
                    if any(k in decoded_url for k in ["voe.sx", "streamwish", "vidhide", "streamtape", "mega.nz", "d-s.io"]):
                        print(decoded_url)
                        sys.exit(0)
                except Exception:
                    pass
    except Exception:
        pass

# PRIORIDAD 2: Reproductores HLS integrados (jkplayer)
player_urls = re.findall(r'src=["\'](https://jkanime\.net/jkplayer/[^"\']+)["\']', html)
for p_url in player_urls:
    p_req = urllib.request.Request(p_url, headers={
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)',
        'Referer': episode_url
    })
    try:
        p_html = urllib.request.urlopen(p_req).read().decode('utf-8', errors='ignore')
        m = re.search(r'hls\.loadSource\(\s*[\'\"]([^\'\"]+)[\'\"]\s*\)', p_html)
        if m:
            print(m.group(1))
            sys.exit(0)
        m = re.search(r'<source\s+src=[\'\"]([^\'\"]+)[\'\"]', p_html)
        if m:
            stream_url = re.sub(r'[^\x20-\x7E]', '', m.group(1))
            if 'http' in stream_url:
                stream_url = stream_url[stream_url.find('http'):]
            print(stream_url)
            sys.exit(0)
    except Exception:
        pass
END_STREAM
}

main() {
    clear
    check_dependencies wget fzf grep sed python3 jq curl

    local search_term="$arg1"
    if [[ -z "$search_term" ]]; then
        local prompt_str=$'\001\033[0;32m\002[?] BUSCAR ANIME > \001\033[0m\002'
        read -r -p "$prompt_str" search_term
        clear
    fi

    if [[ -z "$search_term" ]]; then
        exit 0
    fi

    echo -e "${CYAN}[~] BUSCANDO '${search_term}'...${NC}"

    resultados=$(search_animes "$search_term")

    if [[ -z "$resultados" ]]; then
        echo -e "${RED}[-] No se encontraron resultados para '${search_term}'${NC}"
        read -p "Presiona ENTER para volver a buscar..." dummy
        arg1=""
        main
        return
    fi

    num_animes=$(echo "$resultados" | wc -l)
    if [[ "$num_animes" == "1" ]]; then
        opcion="$resultados"
    else
        clear
        echo -e "${GREEN}[*] RESULTADOS DE BÚSQUEDA para '${search_term}'${NC}"
        opcion=$( (echo "$resultados"; echo "Salir|Salir") | tac | fzf --delimiter='\|' --with-nth=1 --prompt="[ SELECCIONA UN ANIME ] > " --height=~20 --border=rounded --info=inline --margin=1 --layout=reverse --color=fg:#d0d0d0,bg:-1,hl:#00ff00,fg+:#ffffff,bg+:-1,hl+:#00ff00,pointer:#00ff00,info:#00ff00,prompt:#00ff00)
    fi

    # Manejo de tecla ESC o Salir -> Volver al buscador
    if [[ -z "$opcion" ]] || [[ "$opcion" == "Salir|Salir" ]] || [[ "$opcion" == "Salir" ]]; then
        arg1=""
        main
        return
    fi

    clear

    titulo_elegido=$(echo "$opcion" | cut -d'|' -f1)
    nuevaurl=$(echo "$opcion" | cut -d'|' -f2)

    echo -e "${CYAN}[~] OBTENIENDO METADATOS DE: ${titulo_elegido}...${NC}"

    meta=$(get_anime_metadata "$nuevaurl")
    num_episodios=$(echo "$meta" | cut -d'|' -f1)
    tipo=$(echo "$meta" | cut -d'|' -f2)

    if [ -z "$num_episodios" ] || [ "$num_episodios" -lt 1 ]; then
        num_episodios=1
    fi

    last_cap=$(python3 - <<END
import sqlite3, os
def conection():
    home_dir = os.path.expanduser("~")
    db_path = os.path.join(home_dir, "ani-es", "history.db")
    return sqlite3.connect(db_path)

anime = '$titulo_elegido'
conect = conection()
cursor = conect.cursor()
cursor.execute("SELECT count(name) FROM sqlite_master WHERE type='table' AND name='animes'")
if cursor.fetchone()[0] == 0:
    cursor.execute("CREATE TABLE animes (id INTEGER PRIMARY KEY, anime TEXT, last_cap TEXT, progress TEXT)")
    conect.commit()
cursor.execute('SELECT * FROM animes WHERE anime = ?', (anime,))
row = cursor.fetchone()
if row:
    print(row[2])
END
)

    if [ "$CONTINUE" == 1 ] && [ -n "$last_cap" ]; then
        capi=$last_cap
        progress=$(python3 - <<END
import sqlite3, os
def conection():
    home_dir = os.path.expanduser("~")
    db_path = os.path.join(home_dir, "ani-es", "history.db")
    return sqlite3.connect(db_path)

conect = conection()
cursor = conect.cursor()
cursor.execute(f'SELECT progress from animes WHERE anime="$titulo_elegido"')
response=cursor.fetchone()
if response and response[0]:
    print(response[0])
else:
    print("00:00:00")
END
)
    else
        clear
        echo -e "${GREEN}[+] ANIME: ${titulo_elegido} (${num_episodios} episodios)${NC}"
        capi=$(seq 1 "$num_episodios" | fzf \
            --prompt="[ SELECCIONA UN EPISODIO ] > " \
            --height=~30 \
            --border=rounded \
            --reverse \
            --layout=reverse \
            --color=fg:#d0d0d0,bg:-1,hl:#00ff00,fg+:#ffffff,bg+:-1,hl+:#00ff00,pointer:#00ff00,info:#00ff00,prompt:#00ff00)
    fi

    # Manejo de tecla ESC al elegir episodio -> Volver a la búsqueda
    if [ -z "$capi" ]; then
        arg1=""
        main
        return
    fi

    clear

    if [ "$tipo" == "Pelicula" ]; then
        capi="pelicula"
    fi

    play_episode() {
        local ep_num=$1
        local ep_url="${nuevaurl%%/}/$ep_num"

        clear
        echo -e "${CYAN}[~] OBTENIENDO TRANSMISIÓN (AUDIO LATINO) PARA EL CAPÍTULO $ep_num...${NC}"

        src_contenido=$(extract_stream "$ep_url")

        if [ -z "$src_contenido" ]; then
            echo -e "${RED}[-] No se pudo extraer la transmisión para el capítulo $ep_num.${NC}"
            read -p "Presiona ENTER para continuar..." dummy
            arg1=""
            main
            return
        fi

        clear
        echo -e "${GREEN}[+] REPRODUCTOR INICIADO: ${titulo_elegido} - CAPÍTULO $ep_num${NC}"
        echo -e "${CYAN}[~] Cargando transmisión... (Cierra la ventana de MPV para continuar)${NC}"

        ENV=$(detect_env)
        pos=0

        case "$ENV" in
            wsl|windows)
                if command -v mpv >/dev/null 2>&1; then
                    pos=$(mpv --cache=yes --demuxer-max-bytes=150M --demuxer-readahead-secs=300 --start=$progress --msg-level=ffmpeg=no --force-media-title="$titulo_elegido - Capítulo $ep_num" "$src_contenido" | grep -oE 'AV: [0-9]{2}:[0-9]{2}:[0-9]{2}' | tail -n 1 | sed 's/AV: //g' 2>&1)
                elif command -v mpv.exe >/dev/null 2>&1; then
                    pos=$(mpv.exe --cache=yes --demuxer-max-bytes=150M --demuxer-readahead-secs=300 --start=$progress --msg-level=ffmpeg=no --force-media-title="$titulo_elegido - Capítulo $ep_num" "$src_contenido" | grep -oE 'AV: [0-9]{2}:[0-9]{2}:[0-9]{2}' | tail -n 1 | sed 's/AV: //g' 2>&1)
                else
                    echo -e "${RED}mpv no encontrado en el PATH de Windows${NC}"
                fi
                ;;
            termux)
                if pm list packages | grep -q 'org.videolan.vlc'; then
                    am start -a android.intent.action.VIEW -d "$src_contenido" -n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity
                    pos=0
                else
                    termux-open-url "$src_contenido"
                    pos=0
                fi
                ;;
            linux)
                if command -v mpv >/dev/null 2>&1; then
                    pos=$(mpv --cache=yes --demuxer-max-bytes=150M --demuxer-readahead-secs=300 --start=$progress -v --msg-level=ffmpeg=no --force-media-title="$titulo_elegido - Capítulo $ep_num" "$src_contenido" | grep -oE 'AV: [0-9]{2}:[0-9]{2}:[0-9]{2}' | tail -n 1 | sed 's/AV: //g' 2>&1)
                elif command -v mpv.exe >/dev/null 2>&1; then
                    pos=$(mpv.exe --cache=yes --demuxer-max-bytes=150M --demuxer-readahead-secs=300 --start=$progress -v --msg-level=ffmpeg=no --force-media-title="$titulo_elegido - Capítulo $ep_num" "$src_contenido" | grep -oE 'AV: [0-9]{2}:[0-9]{2}:[0-9]{2}' | tail -n 1 | sed 's/AV: //g' 2>&1)
                fi
                ;;
        esac

        python3 - <<END
import sqlite3, os
def conection():
    home_dir = os.path.expanduser("~")
    db_path = os.path.join(home_dir, "ani-es", "history.db")
    return sqlite3.connect(db_path)

anime = '$titulo_elegido'
capi = '$ep_num'
progress = "$pos"

conect = conection()
cursor = conect.cursor()
cursor.execute("SELECT count(name) FROM sqlite_master WHERE type='table' AND name='animes'")
if cursor.fetchone()[0] == 0:
    cursor.execute("CREATE TABLE animes (id INTEGER PRIMARY KEY, anime TEXT, last_cap TEXT, progress TEXT)")
    conect.commit()

cursor.execute("PRAGMA table_info(animes)")
columns = [col[1] for col in cursor.fetchall()]

if "progress" not in columns:
    cursor.execute("ALTER TABLE animes ADD COLUMN progress TEXT DEFAULT 0")
    conect.commit()

cursor.execute('SELECT * FROM animes WHERE anime = ?', (anime,))
row = cursor.fetchone()

if row is None:
    cursor.execute('INSERT INTO animes (anime, last_cap, progress) VALUES (?, ?, ?)', (anime, capi, progress))
else:
    try:
        if int(row[2]) < int(capi):
            cursor.execute("UPDATE animes SET last_cap = ?, progress = ? WHERE anime = ?", (capi, progress, anime))
        else:
            cursor.execute("UPDATE animes SET progress = ? WHERE anime = ?", (progress, anime))
    except Exception:
        cursor.execute("UPDATE animes SET last_cap = ?, progress = ? WHERE anime = ?", (capi, progress, anime))

conect.commit()
END

        op=$( (echo "Siguiente"; echo "Retroceder"; echo "Atras") | tac | fzf --prompt="[ ACCIÓN ] > " --height=12 --border=rounded --info=inline --margin=1 --layout=reverse --color=fg:#d0d0d0,bg:-1,hl:#00ff00,fg+:#ffffff,bg+:-1,hl+:#00ff00,pointer:#00ff00,info:#00ff00,prompt:#00ff00)

        if [[ "$op" == "Siguiente" ]]; then
            progress="00:00:00"
            play_episode $((ep_num + 1))
        elif [[ "$op" == "Retroceder" ]]; then
            progress="00:00:00"
            if [ $ep_num -gt 1 ]; then
                play_episode $((ep_num - 1))
            else
                play_episode 1
            fi
        elif [[ "$op" == "Atras" ]] || [[ -z "$op" ]]; then
            arg1=""
            main
        fi
    }

    play_episode "$capi"
}

main
