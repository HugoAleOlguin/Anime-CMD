        local audio_toggle_label="🇯🇵 Cambiar a Subtitulado"
        if [ "$AUDIO_PREF" != "latino" ]; then
            audio_toggle_label="🔊 Cambiar a Audio Latino"
        fi

        op=$( (echo "▶ Siguiente capítulo"; echo "◀ Capítulo anterior"; echo "$audio_toggle_label"; echo "🔍 Buscar otro anime"; echo "❌ Salir") | fzf \
            --prompt="👉 [ ¿QUÉ DESEAS HACER? ] > " \
            --height=14 \
            --border=rounded \
            --info=inline \
            --margin=1 \
            --layout=reverse \
            --color=fg:#d0d0d0,bg:-1,hl:#00ff00,fg+:#ffffff,bg+:-1,hl+:#00ff00,pointer:#00ff00,info:#00ff00,prompt:#00ff00)

        if [[ "$op" == *"Siguiente"* ]]; then
            progress="00:00:00"
            play_episode $((ep_num + 1))
        elif [[ "$op" == *"anterior"* ]]; then
            progress="00:00:00"
            if [ $ep_num -gt 1 ]; then
                play_episode $((ep_num - 1))
            else
                play_episode 1
            fi
        elif [[ "$op" == *"Cambiar a"* ]]; then
            if [[ "$AUDIO_PREF" == "latino" ]]; then
                AUDIO_PREF="sub"
            else
                AUDIO_PREF="latino"
            fi
            play_episode $ep_num
        elif [[ "$op" == *"Buscar otro"* ]] || [[ -z "$op" ]]; then
            arg1=""
            main
        elif [[ "$op" == *"Salir"* ]]; then
            clear
            exit 0
        fi
    }

    play_episode "$capi"
}

