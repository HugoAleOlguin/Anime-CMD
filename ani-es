extract_stream() {
    local anime_url="$1"
    local provider="$2"
    local episode_num="$3"
    local pref_audio="$4"
    "$PY_CMD" - "$anime_url" "$provider" "$episode_num" "$pref_audio" <<'END_STREAM'
import sys, re, json, base64, urllib.request, ssl
try:
    from bs4 import BeautifulSoup
except ImportError:
    BeautifulSoup = None

if hasattr(sys.stdout, 'reconfigure'):
    sys.stdout.reconfigure(encoding='utf-8', errors='replace')

anime_url = sys.argv[1]
provider = sys.argv[2] if len(sys.argv) > 2 else "jkanime"
episode_num = str(sys.argv[3]) if len(sys.argv) > 3 else "1"
pref_audio = sys.argv[4] if len(sys.argv) > 4 else "latino"

ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE

HEADERS = {
    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36',
    'Accept': '*/*'
}

def fetch_html(url, timeout=5, referer=None):
    headers = dict(HEADERS)
    if referer:
        headers['Referer'] = referer
    try:
        req = urllib.request.Request(url, headers=headers)
        return urllib.request.urlopen(req, timeout=timeout, context=ctx).read().decode('utf-8', errors='ignore')
    except Exception:
        return None

def resolve_direct_stream(url, referer=None):
    if not url:
        return None, None
    url_lower = url.lower()

    if bool(re.search(r'\.(?:mp4|m3u8)(?:[?#]|$)', url_lower)):
        return url, referer

    html = fetch_html(url, timeout=5, referer=referer)
    if not html:
        if any(k in url_lower for k in ['ok.ru', 'mega.nz', 'streamtape.com', 'filemoon', 'vidhide', 'doodstream', 'uqload']):
            return url, referer
        return None, None

    # 1. Mediafire
    if 'mediafire.com' in url_lower:
        m = re.search(r'href=[\"\'](https?://download[^\'\"]+)[\"\']', html)
        if m: return m.group(1), 'https://www.mediafire.com/'
        m = re.search(r'aria-label=[\"\']Download file[\"\']\s+href=[\"\']([^\"\']+)[\"\']', html)
        if m: return m.group(1), 'https://www.mediafire.com/'

    # 2. Mp4upload
    if 'mp4upload.com' in url_lower:
        m = re.search(r'src:\s*[\"\'](https?://[^\'\"]+\.mp4)[\"\']', html)
        if m: return m.group(1), 'https://www.mp4upload.com/'
        m = re.search(r'<source\s+src=[\"\'](https?://[^\'\"]+\.mp4)[\"\']', html)
        if m: return m.group(1), 'https://www.mp4upload.com/'

    # 3. YourUpload
    if 'yourupload.com' in url_lower:
        m = re.search(r'file:\s*[\"\'](https?://[^\'\"]+\.mp4[^\'\"]*)[\"\']', html)
        if m: return m.group(1), 'https://www.yourupload.com/'
        m = re.search(r'data-url=[\"\']([^\"\']+\.mp4[^\'\"]*)[\"\']', html)
        if m: return m.group(1), 'https://www.yourupload.com/'

    # 4. Voe.sx
    if 'voe.sx' in url_lower or 'voe-' in url_lower:
        m = re.search(r'[\"\']hls[\"\']\s*:\s*[\"\'](https?://[^\'\"]+)[\"\']', html)
        if m: return m.group(1), 'https://voe.sx/'
        m = re.search(r'[\"\']mp4[\"\']\s*:\s*[\"\'](https?://[^\'\"]+)[\"\']', html)
        if m: return m.group(1), 'https://voe.sx/'
        m = re.search(r'window\.location\.href\s*=\s*[\"\'](https?://[^\'\"]+)[\"\']', html)
        if m: return resolve_direct_stream(m.group(1), referer=url)

    # 5. Streamwish / swdyu / sfastwish
    if any(k in url_lower for k in ['streamwish', 'swdyu', 'sfastwish', 'wishfast', 'wishembed', 'strwish']):
        m = re.search(r'sources:\s*\[\{\s*file:\s*[\"\'](https?://[^\'\"]+)[\"\']', html)
        if m: return m.group(1), referer
        m = re.search(r'file:\s*[\"\'](https?://[^\'\"]+\.m3u8[^\'\"]*)[\"\']', html)
        if m: return m.group(1), referer

    # 6. HTML5 tags
    m = re.search(r'<source\s+[^>]*src=[\"\'](https?://[^\'\"]+)[\"\']', html)
    if m: return m.group(1), referer

    m = re.search(r'hls\.loadSource\(\s*[\"\'](https?://[^\'\"]+)[\"\']\s*\)', html)
    if m: return m.group(1), referer

    if any(k in url_lower for k in ['ok.ru', 'mega.nz', 'streamtape.com', 'filemoon', 'vidhide', 'doodstream', 'uqload']):
        return url, referer

    return None, None

def unpack_streamwish(html):
    m = re.search(r"eval\(function\(p,a,c,k,e,d\)\{.*?return p\}\('(.*?)',(\d+),(\d+),'([^']+)'\.split\('\|'\)", html, re.DOTALL)
    if not m: return None
    try:
        p, a, c, k = m.group(1), int(m.group(2)), int(m.group(3)), m.group(4).split('|')
        def baseN(num, b):
            digits = '0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'
            res = ''
            while num:
                res = digits[num % b] + res
                num //= b
            return res or '0'
        for i in range(c - 1, -1, -1):
            if i < len(k) and k[i]:
                p = re.sub(r'\b' + baseN(i, a) + r'\b', k[i], p)
        m3u8 = re.search(r'https?://[^\s\"\']+\.m3u8[^\s\"\']*', p)
        return m3u8.group(0) if m3u8 else None
    except Exception:
        return None

def verify_stream(url, referer=None, timeout=2.5):
    if not url or not url.startswith('http'):
        return bool(url)
    try:
        headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',
            'Referer': referer or ''
        }
        if '.m3u8' not in url.lower():
            headers['Range'] = 'bytes=0-1024'
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, timeout=timeout, context=ctx) as resp:
            ctype = resp.headers.get('Content-Type', '').lower()
            if 'text/html' in ctype:
                return False
            return resp.status in (200, 206)
    except urllib.error.HTTPError as e:
        if e.code in (401, 403, 404, 410):
            return False
        return True
    except Exception:
        return False

def extract_streamtape(html):
    for target_id in ['robotlink', 'botlink']:
        m = re.search(r"document\.getElementById\(['\"]" + target_id + r"['\"]\)\.innerHTML\s*=\s*['\"]([^'\"]+)['\"]\s*\+\s*\(['\"]([^'\"]+)['\"]\)\.substring\((\d+)\)(?:\.substring\((\d+)\))?", html)
        if m:
            try:
                base = m.group(1)
                token_str = m.group(2)
                s1 = int(m.group(3))
                s2 = int(m.group(4)) if m.group(4) else 0
                token_clean = token_str[s1:][s2:]
                full = base + token_clean
                if full.startswith('//'): full = 'https:' + full
                full = re.sub(r'streamtape\.[a-z0-9]+', 'streamtape.com', full)
                if '&stream=1' not in full:
                    full += '&stream=1'
                return full
            except Exception:
                pass
    return None

