}
PROV_PRIO = {'animeonline': -1, 'tioanime': 0, 'jkanime': 1, 'monoschinos': 2, 'animeflv': 3, 'tiohentai': 0}

def normalize_clean(txt):
    t = re.sub(r'([a-z])([A-Z])', r'\1 \2', txt)
    t = t.lower()
    t = re.sub(r'[\(\[\{].*?[\)\]\}]', ' ', t)
    t = re.sub(r'[^a-z0-9\s]', ' ', t)
    return ' '.join(t.split())

def get_canonical_key(title, tag):
    # Separar CamelCase (ej: ReZero -> Re Zero)
    t = re.sub(r'([a-z])([A-Z])', r'\1 \2', title)
    t = t.lower().strip()
    t = re.sub(r'^(?:anime|pelicula|película|ova|donghua)\s+', '', t)
    t = re.sub(r'[\(\[\{]?(?:audio\s+latino|latino|castellano|sub\s+español|subtitulado|sub|doblaje)[\)\]\}]?', ' ', t)
    t = re.sub(r'[:\-–—_!?\.,\(\)\[\]\{\}\'\"]', ' ', t)
    t = re.sub(r'\b2nd\b|\b2da\b', '2', t)
    t = re.sub(r'\b3rd\b|\b3ra\b', '3', t)
    t = re.sub(r'\b4th\b|\b4ta\b', '4', t)
    t = re.sub(r'\b5th\b|\b5ta\b', '5', t)
    canonical = ' '.join(t.split())
    audio_type = 'lat' if 'LAT' in tag else ('cast' if 'CAST' in tag else 'sub')
    return (canonical, audio_type)

def format_server_badge(p_list):
    parts = []
    for p in p_list:
        pid = p['id']
        color = PROVIDER_COLORS.get(pid, '\033[1;37m')
        name = PROVIDER_NAMES.get(pid, pid.capitalize())
        parts.append(f"{color}{name}\033[0m")
    sep = " \033[0;37m/\033[0m "
    return f"\033[0;37m[\033[0m{sep.join(parts)}\033[0;37m]\033[0m"

def ansi_ljust(text, width):
    visible = len(re.sub(r'\033\[[0-9;]*m', '', text))
    return text + (' ' * max(0, width - visible))

seen_urls = set()
unique_results = []
for item in all_results:
    tag, prov, title, href, p_id = item
    key = (href, p_id)
    if key not in seen_urls:
        seen_urls.add(key)
        unique_results.append(item)

groups = {}
for item in unique_results:
    tag, prov, title, href, p_id = item
    key = get_canonical_key(title, tag)
    if key not in groups:
        groups[key] = {
            'tag': tag,
            'titles': [],
            'providers': []
        }
    g = groups[key]
    g['titles'].append(title)
    if not any(p['id'] == p_id for p in g['providers']):
        g['providers'].append({'id': p_id, 'name': prov, 'href': href})

consolidated = []
for key, g in groups.items():
    g['providers'].sort(key=lambda x: PROV_PRIO.get(x['id'], 99))
    best_title = min(g['titles'], key=lambda t: (len(t), t))
    clean_display = re.sub(r'\s*[\(\[\{]?(?:audio\s+latino|sub\s+español|castellano)[\)\]\}]?', '', best_title, flags=re.I).strip()
    clean_display = html.unescape(clean_display)
    clean_display = ' '.join(clean_display.split())
    g['clean_title'] = clean_display
    consolidated.append(g)

clean_q = normalize_clean(query)
q_words = [w for w in clean_q.split() if len(w) > 1]

def score_group(g):
    tag = g['tag']
    norm_title = normalize_clean(g['clean_title'])
    
    if norm_title == clean_q:
        match_tier = 0
    elif norm_title.startswith(clean_q + ' ') or norm_title.startswith(clean_q):
        match_tier = 1
    elif all(w in norm_title for w in q_words) if q_words else False:
        match_tier = 2
    elif any(w in norm_title for w in q_words) if q_words else False:
        match_tier = 3
    else:
        match_tier = 4

    if force_sub:
        audio_prio = 0 if 'SUB' in tag else (1 if 'LAT' in tag else 2)
    else:
        audio_prio = 0 if 'LAT' in tag else (1 if 'SUB' in tag else 2)

    server_count_prio = -len(g['providers'])
    best_prov_prio = PROV_PRIO.get(g['providers'][0]['id'], 99)

    return (match_tier, audio_prio, server_count_prio, best_prov_prio, norm_title)

consolidated.sort(key=score_group)

lat_count = sum(1 for g in consolidated if 'LAT' in g['tag'])
sys.stderr.write(f"\033[0;32m[+] Total:\033[0m {len(consolidated)} animes encontrados ({lat_count} con Audio Latino 🔊)\n\n")

max_badge = max(len(re.sub(r'\033\[[0-9;]*m', '', format_server_badge(g['providers']))) for g in consolidated) if consolidated else 20
max_badge = max(max_badge, 20)

for g in consolidated:
    tag = g['tag']
    tag_color = '\033[1;32m🔊 [LAT]\033[0m' if 'LAT' in tag else ('\033[1;33m🇯🇵 [SUB]\033[0m' if 'SUB' in tag else '\033[1;31m🇪🇸 [CAST]\033[0m')
    badge = format_server_badge(g['providers'])
    badge_padded = ansi_ljust(badge, max_badge)
    clean_title = g['clean_title']
    main_url = g['providers'][0]['href']
    main_pid = g['providers'][0]['id']
    servers_encoded = "@@@".join(f"{p['id']}|{PROVIDER_NAMES.get(p['id'], p['id'])}|{p['href']}" for p in g['providers'])
    print(f"{tag_color}  {badge_padded}  {clean_title}\t{clean_title}\t{main_url}\t{main_pid}\t{servers_encoded}")
END_SEARCH
}

